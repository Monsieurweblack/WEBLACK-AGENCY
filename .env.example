# Copier ce fichier en .env et renseigner les vraies valeurs.
# .env est gitignored — ne jamais committer de vrai secret.

# --- Sanity (déjà utilisé par le site — src/lib/content.ts) ---
SANITY_PROJECT_ID=pzpm4xjp
SANITY_DATASET=production
# Token role "editor" — lecture/écriture de contenu (jamais utilisé pour déployer le Studio)
SANITY_WRITE_TOKEN=
# Token role "developer" ou "administrator" — uniquement pour `sanity deploy` (Studio/schema)
SANITY_DEPLOY_TOKEN=

# --- Moteur éditorial (editorial-engine/) ---
# Clé API OpenAI — requise pour l'analyse, l'extraction de faits et la génération.
OPENAI_API_KEY=
# Modèle OpenAI par défaut (optionnel, défaut: gpt-4o-mini) — utilisé pour toute
# étape dont le modèle spécifique ci-dessous n'est pas renseigné.
OPENAI_MODEL=
# Modèles par tâche (optionnels) — permet d'utiliser un modèle plus léger/moins
# cher pour la classification (analyse, fact-check) qu'un modèle plus capable
# pour la rédaction longue. Non renseignés = retombent sur OPENAI_MODEL.
OPENAI_MODEL_ANALYSIS=
OPENAI_MODEL_WRITING=
OPENAI_MODEL_FACTCHECK=

# Seuil de risque de copie (0-100) au-dessus duquel un article est bloqué (jamais écrit dans Sanity).
COPY_RISK_BLOCK_THRESHOLD=40

# draft   -> tout article généré est créé comme brouillon Sanity (défaut, recommandé)
# review  -> identique à draft techniquement ; à utiliser pour signaler un lot en attente de relecture humaine
# publish -> autorise la publication automatique, mais UNIQUEMENT si editorialScore et
#            confidenceScore dépassent les seuils ci-dessous ET que le contrôle qualité passe —
#            sinon l'article retombe en brouillon. À activer en connaissance de cause seulement :
#            voir "Discipline de non-fabrication" dans CLAUDE.md.
EDITORIAL_MODE=draft
AUTO_PUBLISH_SCORE=90
AUTO_PUBLISH_CONFIDENCE=90

# Signature affichée sur les articles générés (jamais inventée automatiquement — obligatoire dès que EDITORIAL_MODE != draft, ou pour toute génération).
EDITORIAL_DEFAULT_AUTHOR=

# Fréquence du mode veille (`npm run editorial:run -- --watch`), en minutes.
EDITORIAL_INTERVAL_MINUTES=60
