---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Seo from "../components/layout/Seo.astro";
import ConsentBanner from "../components/layout/ConsentBanner.astro";
import NewsletterPopup from "../components/sections/NewsletterPopup.astro";
import { useTranslations, type Lang, type TranslationMap } from "../i18n/utils";
import { LOCALES } from "../i18n/locales";
import { getSiteSettings } from "../lib/content";
import { responsiveImage, type ImageCrop } from "../lib/responsive-image";
// Importées en `?url` pour que Vite renvoie le chemin empreinté réellement
// servi : écrire ces noms à la main préchargerait un fichier périmé au
// premier changement de version de la police. Même fichier que l'@import
// de global.css (« standard ») : en diverger ferait télécharger les deux.
import fraunces from "@fontsource-variable/fraunces/files/fraunces-latin-standard-normal.woff2?url";
import manrope from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  bodyClass?: string;
  translations?: TranslationMap;
  /**
   * L'image LCP de la page, avec EXACTEMENT les mêmes src, width et sizes
   * que le RemoteImage qui l'affiche. Elle arrive sinon après ~110 Ko de
   * HTML (CSS inline, en-tête, menu) : 2 à 3 allers-retours de découverte
   * perdus sur un réseau lent, mesurés à 0,73 s sur /talent/.
   */
  lcpImage?: { src: string; width: number; sizes?: string; portrait?: string; crop?: ImageCrop };
}

const { lang, title, description, image, imageAlt, noindex, bodyClass, translations, lcpImage } = Astro.props;
const t = useTranslations(lang);
const siteSettings = await getSiteSettings(lang);
// Variante locale : seules les sources AVIF sont préchargées, filtrées par
// `type` — un navigateur sans AVIF les ignore et retombe sur le <picture>, au
// lieu de télécharger deux formats. Avec un recadrage portrait, deux
// préchargements à media exclusifs : un seul s'applique, celui que le
// <picture> choisira.
const lcp = lcpImage ? await responsiveImage(lcpImage.src, lcpImage.width, lcpImage.portrait, lcpImage.crop) : null;
const lcpSizes = lcpImage?.sizes ?? "100vw";
const lcpPreloads =
  lcp?.kind === "local"
    ? lcp.sources
        .filter((source) => source.type === "image/avif")
        .map((source) => ({
          type: source.type,
          srcset: source.srcset,
          sizes: source.sizes ?? lcpSizes,
          media:
            source.media ??
            (lcpImage?.portrait
              ? `not all and (max-aspect-ratio: ${lcpImage.portrait})`
              : lcpImage?.crop
                ? `not all and ${lcpImage.crop.media}`
                : undefined),
        }))
    : lcp?.kind === "remote" && lcp.srcset
      ? [{ type: undefined, srcset: lcp.srcset, sizes: lcpSizes, media: undefined }]
      : [];
const lcpPreload = lcpPreloads.length > 0;
---

<!doctype html>
<html lang={LOCALES[lang].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <!--
      Doit rester le tout premier élément après charset — avant tout script,
      même inline. Un navigateur qui n'a pas encore rencontré cette balise
      utilise sa largeur de viewport par défaut (historiquement 980px,
      pensée pour une page desktop) : si un <script> non-async la précède
      dans le document, l'analyseur HTML s'arrête pour l'exécuter avant de
      continuer à parser — donc avant que cette balise n'existe seulement
      dans le DOM — et Safari iOS en particulier peut peindre une première
      image avec cette largeur desktop, avant de rebasculer sur le mobile
      une fois la balise enfin appliquée. C'est exactement le flash
      desktop→mobile observé en production ; elle vivait après les deux
      scripts inline ci-dessous, ce qui suffisait à le provoquer.
    -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      L'image LCP de presque toutes les pages vient de cdn.sanity.io. Sans
      preconnect, le navigateur ne résout le DNS et ne négocie le TLS qu'au
      moment où il rencontre la balise <img>, loin dans le document : la
      poignée de main s'ajoute intégralement au Largest Contentful Paint.
      Ces deux lignes la déplacent au tout début du chargement.

      Une seule origine est préconnectée volontairement : chaque preconnect
      immobilise une connexion, et en multiplier sur des hôtes secondaires
      ralentirait celui qui compte.
    -->
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.sanity.io" />
    <!-- Avant les fontes : l'image LCP part en premier sur la connexion. -->
    {
      lcpPreloads.map((preload) => (
        <link
          rel="preload"
          as="image"
          type={preload.type}
          media={preload.media}
          imagesrcset={preload.srcset}
          imagesizes={preload.sizes}
          fetchpriority="high"
        />
      ))
    }
    {lcpPreload && <script is:inline>document.documentElement.classList.add("defer-media");</script>}
    <!--
      Les deux seules fontes réellement téléchargées sur une page FR/EN —
      les autres sous-ensembles (cyrillique, grec, vietnamien) portent un
      unicode-range et ne sont jamais demandés. Elles sont découvertes
      aujourd'hui APRÈS l'analyse de la feuille de style ; avec
      font-display:swap, cela se voit à l'œil sous forme de bascule de
      police. Les URL sont importées plutôt qu'écrites en dur : leur
      empreinte change à chaque build.

      Sauf quand la page précharge une image LCP (bandeaux Talent, études de
      cas) : les fontes (91 Ko) partageaient alors la bande passante avec
      l'image et l'arrivaient avant elle. Le texte s'affiche d'abord dans les
      polices de repli calibrées (global.css), aux mêmes métriques : la
      bascule ne décale rien (mesuré, bascule forcée sur 6 routes × 6 largeurs).
    -->
    {
      !lcpPreload && (
        <>
          <link rel="preload" as="font" type="font/woff2" href={fraunces} crossorigin />
          <link rel="preload" as="font" type="font/woff2" href={manrope} crossorigin />
        </>
      )
    }
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("weblack-theme");
          var theme = stored === "light" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>
    <!--
      Basic Consent Mode: gtag.js itself is never requested — no script, no
      cookie, no request to googletagmanager.com — until the visitor grants
      analytics consent. weblackLoadGA4() is the single place that does the
      loading; it's exposed on window so consent.ts (loaded later, when the
      visitor interacts with the banner) can call the exact same path. A
      prior "accepted" choice (read synchronously here, same
      "weblack-consent" key consent.ts writes to) loads GA4 immediately on
      return visits; no choice yet, or a prior refusal, leaves it unloaded.
    -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      window.gtag = gtag;

      var GA_MEASUREMENT_ID = "G-1Y2Q6BGRZ8";
      var ga4Loaded = false;

      function weblackLoadGA4() {
        if (ga4Loaded) return;
        ga4Loaded = true;
        gtag("consent", "default", {
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
          analytics_storage: "granted",
        });
        var script = document.createElement("script");
        script.async = true;
        script.src = "https://www.googletagmanager.com/gtag/js?id=" + GA_MEASUREMENT_ID;
        document.head.appendChild(script);
        gtag("js", new Date());
        gtag("config", GA_MEASUREMENT_ID);
      }
      window.__weblackLoadGA4 = weblackLoadGA4;

      try {
        var storedConsent = localStorage.getItem("weblack-consent");
        if (storedConsent) {
          var parsedConsent = JSON.parse(storedConsent);
          if (parsedConsent && parsedConsent.analytics === true) weblackLoadGA4();
        }
      } catch (e) {}
    </script>
    <!--
      Continuité couverture → étude de cas (voir motion.css, « work-media »).
      Le nom de transition est posé au dernier moment, sur UN seul élément :
      dans l'ancienne page, la couverture visible du lien cliqué
      (pageswap) ; dans la nouvelle, le bandeau [data-vt-hero] (pagereveal,
      avant le premier rendu — d'où un script classique dans le <head>). Un
      nom écrit en dur dans les gabarits se retrouverait en double dès que
      deux cartes du même projet cohabitent, et le navigateur annulerait la
      transition. Sans support : rien ne se passe, navigation ordinaire.
    -->
    <script is:inline>
      (function () {
        var NAME = "work-media";
        var WORK = /\/selected-work\/[^/]+\/?$/;
        var path = function (url) {
          return new URL(url, location.href).pathname.replace(/\/$/, "");
        };
        addEventListener("pageswap", function (event) {
          if (!event.viewTransition || !event.activation) return;
          var target = event.activation.entry.url;
          if (!WORK.test(path(target))) return;
          var links = document.querySelectorAll("a[href]");
          for (var i = 0; i < links.length; i++) {
            var media = links[i].querySelector("figure");
            if (!media || path(links[i].href) !== path(target)) continue;
            var box = media.getBoundingClientRect();
            if (box.bottom <= 0 || box.top >= innerHeight) continue;
            media.style.viewTransitionName = NAME;
            event.viewTransition.finished.finally(function () {
              media.style.viewTransitionName = "";
            });
            return;
          }
        });
        addEventListener("pagereveal", function (event) {
          if (!event.viewTransition) return;
          var hero = document.querySelector("[data-vt-hero]");
          if (!hero) return;
          hero.style.viewTransitionName = NAME;
          event.viewTransition.finished.finally(function () {
            hero.style.viewTransitionName = "";
          });
        });
      })();
    </script>
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f3ee" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Seo
      lang={lang}
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      noindex={noindex}
      translations={translations}
      siteSettings={siteSettings}
    />
  </head>
  <body class:list={["bg-(--color-ink)", bodyClass]}>
    <a
      href="#main-content"
      class="label-tracked fixed left-4 top-4 z-[100] -translate-y-24 bg-(--color-gold) px-4 py-2 text-(--color-on-gold) transition-transform focus-visible:translate-y-0"
    >
      {t("common.skipToContent")}
    </a>
    <Header lang={lang} translations={translations} siteSettings={siteSettings} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} siteSettings={siteSettings} />
    <NewsletterPopup lang={lang} />
    <ConsentBanner lang={lang} />
    {
      /*
        Libère les images [data-after-lcp] (voir global.css, .defer-media)
        dès que l'image LCP est arrivée — chargée ou en échec — et au plus
        tard après 5 s, pour qu'aucune image ne reste jamais masquée.
      */
      lcpPreload && (
        <script is:inline>
          (function () {
            var root = document.documentElement;
            var release = function () {
              root.classList.remove("defer-media");
            };
            var hero = document.querySelector('main img[fetchpriority="high"]');
            if (!hero || hero.complete) return release();
            hero.addEventListener("load", release, { once: true });
            hero.addEventListener("error", release, { once: true });
            setTimeout(release, 5000);
          })();
        </script>
      )
    }
  </body>
</html>
