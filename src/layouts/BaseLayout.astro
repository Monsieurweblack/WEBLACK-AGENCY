---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Seo from "../components/layout/Seo.astro";
import { useTranslations, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  bodyClass?: string;
}

const { lang, title, description, image, noindex, bodyClass } = Astro.props;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Seo lang={lang} title={title} description={description} image={image} noindex={noindex} />
  </head>
  <body class:list={["bg-(--color-ink)", bodyClass]}>
    <a
      href="#main-content"
      class="label-tracked fixed left-4 top-4 z-[100] -translate-y-24 bg-(--color-gold) px-4 py-2 text-(--color-ink) transition-transform focus-visible:translate-y-0"
    >
      {t("common.skipToContent")}
    </a>
    <Header lang={lang} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
