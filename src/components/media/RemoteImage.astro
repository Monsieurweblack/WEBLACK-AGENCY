---
import weblackMark from "../../assets/logo/weblack-mark-gold-64.png";
import { responsiveImage, type ImageCrop } from "../../lib/responsive-image";

/**
 * Wrapper for two image sources: hotlinked Unsplash URLs (astro:assets can't
 * optimize remote URLs without remotePatterns, so we build a srcset from
 * Unsplash's own resize query params instead) and local WEBLACK photos in
 * public/photos/ (AVIF/WebP variants built at compile time; the
 * untouched original stays the <img> fallback — see lib/responsive-image.ts).
 *
 * Falls back to a plain on-brand placeholder (never a stock/generic image)
 * when the source 404s — real WEBLACK photography is still pending for most
 * placements, and a broken-image icon isn't an acceptable substitute.
 */
interface Credit {
  photographer: string;
  photographerUrl?: string;
}

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  credit?: Credit;
  creditLabel?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
  /**
   * Comment l'image occupe son cadre. « cover » remplit et rogne — juste
   * pour une photographie. « contain » respecte les proportions — seule
   * option acceptable pour une image dont la composition EST le sujet :
   * un logo rogné n'est plus un logo.
   */
  fit?: "cover" | "contain";
  sizes?: string;
  /**
   * Bandeau plein cadre : rapport de viewport sous lequel le cadre est plus
   * haut que large (« 3/5 »). Sert alors un carré centré qui contient tout ce
   * que le cadre affiche — voir responsiveImage(). Ignoré pour fit="contain".
   */
  portrait?: string;
  /** Recadrage dirigé sous une plage d'écrans (voir ImageCrop). Ignoré pour fit="contain". */
  crop?: ImageCrop;
}

const {
  src,
  alt,
  width,
  height,
  credit,
  creditLabel = "Photo",
  loading = "lazy",
  fetchpriority = "auto",
  class: className,
  fit = "cover",
  sizes = "100vw",
  portrait,
  crop,
} = Astro.props;

/**
 * `src` is typed as a required string, but its actual value traces back to
 * Sanity `externalImage.url` — a free-text field with no upload widget, no
 * schema-level format constraint, and no guarantee it was ever set (see
 * content-integrity.mjs's image checks, which exist precisely because this
 * field has produced missing/empty/local-path values in production before).
 * A crash here previously took down the whole page's build (and the
 * Cloudflare deploy with it) for a data problem that content-integrity
 * already reports on its own — this component must degrade to "no image"
 * instead, independently of that check ever running.
 */
const image = await responsiveImage(src, width, fit === "cover" ? portrait : undefined, fit === "cover" ? crop : undefined);
const isValidUrl = image !== null;
if (!isValidUrl && import.meta.env.DEV) {
  console.warn(`RemoteImage: ignoring invalid src (expected an http(s) URL or a root-relative path): ${JSON.stringify(src)}`);
}
// Variantes calculées dans lib/responsive-image.ts, partagées avec le
// préchargement LCP de BaseLayout : mêmes URL au caractère près.
const localSources = image?.kind === "local" ? image.sources : undefined;
const srcset = image?.kind === "remote" ? image.srcset : undefined;
const finalSrc = image?.src;
---

<figure class:list={["relative m-0", className]}>
  {
    isValidUrl && localSources ? (
      <picture class="contents">
        {localSources.map((source) => (
          <source type={source.type} media={source.media} srcset={source.srcset} sizes={source.sizes ?? sizes} />
        ))}
        <img
          src={src}
          alt={alt}
          width={width}
          height={height}
          loading={loading}
          decoding="async"
          fetchpriority={fetchpriority}
          class:list={["block h-full w-full", fit === "contain" ? "object-contain" : "object-cover"]}
          onerror="this.style.display='none';this.closest('figure')?.querySelector('[hidden]')?.removeAttribute('hidden')"
        />
      </picture>
    ) : isValidUrl ? (
      <img
        src={finalSrc}
        srcset={srcset}
        sizes={sizes}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        decoding="async"
        fetchpriority={fetchpriority}
        class:list={["block h-full w-full", fit === "contain" ? "object-contain" : "object-cover"]}
        onerror="this.style.display='none';this.nextElementSibling?.removeAttribute('hidden')"
      />
    ) : null
  }
  <div hidden={isValidUrl} class="absolute inset-0 flex items-center justify-center bg-(--color-ink-soft)">
    {/* loading="lazy" : masqué (hidden) tant que l'image tient, il n'est alors jamais téléchargé — 7 Ko de moins avant le LCP. */}
    <img src={weblackMark.src} alt="" width="28" height="28" loading="lazy" class="opacity-30" />
  </div>
  {
    credit && (
      <figcaption class="sr-only">
        {creditLabel}: {credit.photographer}
      </figcaption>
    )
  }
</figure>
