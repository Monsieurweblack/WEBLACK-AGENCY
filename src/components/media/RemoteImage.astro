---
import weblackMark from "../../assets/logo/weblack-mark-gold-64.png";
import { isValidImageSrc, isRemoteImageSrc } from "../../lib/image-src";

/**
 * Wrapper for two image sources: hotlinked Unsplash URLs (astro:assets can't
 * optimize remote URLs without remotePatterns, so we build a srcset from
 * Unsplash's own resize query params instead) and local WEBLACK photos
 * pre-sized into public/photos/ (served as-is — they don't support on-the-fly
 * resize params, so no srcset is generated for those).
 *
 * Falls back to a plain on-brand placeholder (never a stock/generic image)
 * when the source 404s — real WEBLACK photography is still pending for most
 * placements, and a broken-image icon isn't an acceptable substitute.
 */
interface Credit {
  photographer: string;
  photographerUrl?: string;
}

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  credit?: Credit;
  creditLabel?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
  /**
   * Comment l'image occupe son cadre. « cover » remplit et rogne — juste
   * pour une photographie. « contain » respecte les proportions — seule
   * option acceptable pour une image dont la composition EST le sujet :
   * un logo rogné n'est plus un logo.
   */
  fit?: "cover" | "contain";
  sizes?: string;
}

const {
  src,
  alt,
  width,
  height,
  credit,
  creditLabel = "Photo",
  loading = "lazy",
  fetchpriority = "auto",
  class: className,
  fit = "cover",
  sizes = "100vw",
} = Astro.props;

/**
 * `src` is typed as a required string, but its actual value traces back to
 * Sanity `externalImage.url` — a free-text field with no upload widget, no
 * schema-level format constraint, and no guarantee it was ever set (see
 * content-integrity.mjs's image checks, which exist precisely because this
 * field has produced missing/empty/local-path values in production before).
 * A crash here previously took down the whole page's build (and the
 * Cloudflare deploy with it) for a data problem that content-integrity
 * already reports on its own — this component must degrade to "no image"
 * instead, independently of that check ever running.
 */
const isValidUrl = isValidImageSrc(src);
const isRemote = isValidUrl && isRemoteImageSrc(src);
if (!isValidUrl && import.meta.env.DEV) {
  console.warn(`RemoteImage: ignoring invalid src (expected an http(s) URL or a root-relative path): ${JSON.stringify(src)}`);
}

function withWidth(url: string, w: number) {
  const u = new URL(url);
  u.searchParams.set("w", String(w));
  u.searchParams.set("q", "80");
  u.searchParams.set("auto", "format");
  u.searchParams.set("fit", "crop");
  return u.toString();
}

const widths = [Math.round(width * 0.75), width, Math.min(width * 1.5, 3200)];
const srcset = isRemote ? widths.map((w) => `${withWidth(src, w)} ${w}w`).join(", ") : undefined;
const finalSrc = isValidUrl ? (isRemote ? withWidth(src, width) : src) : undefined;
---

<figure class:list={["relative m-0", className]}>
  {
    isValidUrl ? (
      <img
        src={finalSrc}
        srcset={srcset}
        sizes={sizes}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        decoding="async"
        fetchpriority={fetchpriority}
        class:list={["block h-full w-full", fit === "contain" ? "object-contain" : "object-cover"]}
        onerror="this.style.display='none';this.nextElementSibling?.removeAttribute('hidden')"
      />
    ) : null
  }
  <div hidden={isValidUrl} class="absolute inset-0 flex items-center justify-center bg-(--color-ink-soft)">
    <img src={weblackMark.src} alt="" width="28" height="28" class="opacity-30" />
  </div>
  {
    credit && (
      <figcaption class="sr-only">
        {creditLabel}: {credit.photographer}
      </figcaption>
    )
  }
</figure>
