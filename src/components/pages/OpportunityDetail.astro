---
/**
 * Fiche publique d'une opportunité (FR/EN).
 *
 * Contenu lu dans Sanity au build (src/lib/opportunities.ts). Seule la
 * clôture à la date limite est réappliquée à la requête par
 * functions/opportunities/[[path]].ts (data-deadline / data-status → blocs
 * data-when="open|closed"), pour qu'une annonce soit affichée clôturée dès
 * l'échéance, sans attendre une reconstruction. « Organisateur confirmé »
 * n'apparaît que si la case est cochée dans Studio.
 */
import { localizedPath, type Lang } from "../../i18n/utils";
import { isClosed, type Opportunity } from "../../lib/opportunities";
import { OPPORTUNITY_COPY, OPPORTUNITY_HERO_SIZES, formatDeadline } from "../../lib/opportunity-copy";
import RemoteImage from "../media/RemoteImage.astro";

interface Props {
  lang: Lang;
  opportunity: Opportunity;
}

const { lang, opportunity: o } = Astro.props;
const c = OPPORTUNITY_COPY[lang];
const x = o.text[lang];
const deadline = formatDeadline(o.deadline, lang);
const closedAtBuild = isClosed(o);

const HERO_SIZES = OPPORTUNITY_HERO_SIZES;
const GALLERY_SIZES = "(min-width: 768px) 33vw, 50vw";
const mailto = `mailto:${o.contact.email}?subject=${encodeURIComponent(`${x.title} — ${c.mailSubject}`)}&body=${encodeURIComponent(c.mailBody)}`;
const facts = [
  { label: c.category, value: x.category },
  { label: c.location, value: x.location },
  { label: c.event, value: x.eventDate },
  { label: c.organizer, value: o.organizer.name },
  { label: c.broadcast, value: o.broadcastPartner },
].filter((f) => Boolean(f.value)) as { label: string; value: string }[];
const verifiedOn = new Date(`${o.lastVerifiedAt}T12:00:00Z`).toLocaleDateString(lang === "en" ? "en-GB" : "fr-FR", { day: "numeric", month: "long", year: "numeric" });
---

<article class="bg-(--color-ink)" data-opportunity={o.slug} data-deadline={o.deadline} data-status={o.status}>
  <header class="px-6 pb-14 pt-36 md:px-10 md:pt-44">
    <div class="mx-auto grid max-w-(--container-content) grid-cols-1 gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:items-end lg:gap-16">
      <div class="min-w-0">
      <a href={localizedPath(lang, "/opportunities")} class="label-tracked text-(--color-paper)/55 transition-colors hover:text-(--color-gold)">&larr; {c.back}</a>
      <p class="label-tracked label-tracked-dot mt-10 text-(--color-gold)">{c.catalogEyebrow} · {x.category}</p>
      <h1 class="font-display mt-5 max-w-4xl text-4xl leading-[1.05] text-balance text-(--color-paper) sm:text-6xl">{x.title}</h1>
      <p class="mt-6 max-w-2xl text-lg text-(--color-paper)/75">{x.summary}</p>

      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4 border-y border-(--color-line) py-6">
        <div>
          <p class="label-tracked text-(--color-paper)/55">{c.deadline}</p>
          <p class="font-display mt-1 text-3xl text-(--color-gold) sm:text-4xl">{deadline}</p>
        </div>
        <p class="label-tracked border border-(--color-gold) px-3 py-2 text-(--color-gold)" data-when="open" hidden={closedAtBuild}>{c.open}</p>
        <p class="label-tracked border border-(--color-paper)/40 px-3 py-2 text-(--color-paper)/70" data-when="closed" hidden={!closedAtBuild}>{c.closed}</p>
        <a
          href="#contact-opportunity"
          class="inline-flex min-h-12 w-full items-center justify-center bg-(--color-gold) px-6 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-(--color-on-gold) transition-colors hover:bg-(--color-gold-bright) sm:w-auto lg:hidden"
          data-when="open"
          hidden={closedAtBuild}>{c.jump} &darr;</a
        >
      </div>
      </div>
      {
        o.image && (
          <figure class="mx-auto w-full max-w-md lg:max-w-none">
            <div class="aspect-[4/5] overflow-hidden bg-(--color-ink-soft)">
              <RemoteImage
                src={o.image.src}
                alt={o.image.alt[lang]}
                width={o.image.width}
                height={o.image.height}
                sizes={HERO_SIZES}
                loading="eager"
                fetchpriority="high"
                class="h-full w-full"
              />
            </div>
            {o.imageCredit && <figcaption class="mt-3 text-xs text-(--color-paper)/50">{o.imageCredit}</figcaption>}
          </figure>
        )
      }
    </div>
  </header>

  <div class="px-6 pb-24 pt-14 md:px-10 md:pb-32">
    <div class="mx-auto grid max-w-(--container-content) grid-cols-1 gap-14 lg:grid-cols-[1.35fr_1fr] lg:gap-20">
      <div class="space-y-14">
        <section aria-labelledby="opp-about">
          <h2 id="opp-about" class="label-tracked text-(--color-gold)">{c.about}</h2>
          <div class="mt-5 max-w-[65ch] space-y-4 text-lg text-(--color-paper)/85">
            {x.intro.map((p) => <p>{p}</p>)}
          </div>
        </section>

        <section aria-labelledby="opp-criteria">
          <h2 id="opp-criteria" class="label-tracked text-(--color-gold)">{c.criteria}</h2>
          <ul class="mt-5 divide-y divide-(--color-line) border-y border-(--color-line)">
            {x.criteria.map((item) => <li class="py-4 text-(--color-paper)/85">{item}</li>)}
          </ul>
        </section>

        <section aria-labelledby="opp-documents">
          <h2 id="opp-documents" class="label-tracked text-(--color-gold)">{c.documents}</h2>
          <ol class="mt-5 divide-y divide-(--color-line) border-y border-(--color-line)">
            {
              x.documents.map((item, i) => (
                <li class="flex gap-5 py-4 text-(--color-paper)/85">
                  <span class="font-display w-6 shrink-0 text-(--color-gold) tabular-nums">{i + 1}</span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ol>
        </section>

        {x.notice && <p class="max-w-[65ch] text-sm text-(--color-paper)/60">{x.notice}</p>}
      </div>

      <aside class="space-y-10 lg:sticky lg:top-28 lg:self-start">
        <div class="scroll-mt-28 border border-(--color-gold) p-6 sm:p-8" id="contact-opportunity">
          <h2 class="font-display text-2xl text-(--color-paper)">{c.contactTitle}</h2>
          {x.specialOffer && <p class="mt-3 font-semibold text-(--color-gold)">{x.specialOffer}</p>}
          <div data-when="open" hidden={closedAtBuild}>
            <p class="mt-3 text-(--color-paper)/75">{c.contactLead}</p>
            <a
              href={mailto}
              class="mt-6 inline-flex min-h-12 w-full items-center justify-center bg-(--color-gold) px-6 py-3 text-center text-sm font-semibold uppercase tracking-[0.08em] text-(--color-on-gold) transition-colors hover:bg-(--color-gold-bright)"
              data-opportunity-contact={o.slug}
            >
              {c.contactCta}
            </a>
            <p class="mt-4 break-all text-sm text-(--color-paper)/70">{o.contact.email}</p>
            <ul class="mt-3 space-y-1 text-sm">
              {
                o.contact.phones.map((p) => (
                  <li>
                    <a href={`tel:${p.tel}`} class="text-(--color-paper)/80 underline-offset-4 hover:text-(--color-gold) hover:underline">
                      <span class="sr-only">{c.call} </span>
                      {p.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <p class="mt-3 text-(--color-paper)/75" data-when="closed" hidden={!closedAtBuild}>{c.closedLead}</p>
        </div>

        <dl class="divide-y divide-(--color-line) border-y border-(--color-line) text-sm">
          {
            facts.map((f) => (
              <div class="grid grid-cols-[9rem_1fr] gap-4 py-3">
                <dt class="label-tracked text-(--color-paper)/50">{f.label}</dt>
                <dd class="text-(--color-paper)/90">{f.value}</dd>
              </div>
            ))
          }
        </dl>
        <div class="space-y-3 text-sm">
          {
            o.organizer.url && (
              <a href={o.organizer.url} rel="noopener" target="_blank" class="label-tracked inline-flex text-(--color-paper)/70 hover:text-(--color-gold)">
                {c.organizerSite} &nearr;
              </a>
            )
          }
          <p class="text-(--color-paper)/55" data-when={o.organizerVerified ? "verified" : "pending"}>{o.organizerVerified ? c.verifiedNote : c.pendingNote}</p>
          <p class="text-(--color-paper)/45" data-verified-on={o.lastVerifiedAt}>{c.checkedOn} {verifiedOn}.</p>
        </div>
      </aside>
    </div>
  </div>

  {
    o.galleries.map((g) => (
      <section class="px-6 pb-24 md:px-10" aria-labelledby={`opp-gallery-${g.id}`}>
        <div class="mx-auto max-w-(--container-content) border-t border-(--color-line) pt-12">
          <div class="flex flex-wrap items-baseline justify-between gap-4">
            <h2 id={`opp-gallery-${g.id}`} class="label-tracked text-(--color-gold)">{g.title[lang]}</h2>
            {o.imageCredit && <p class="text-xs text-(--color-paper)/50">{o.imageCredit}</p>}
          </div>
          <ul class="mt-8 grid grid-cols-2 gap-3 sm:gap-5 md:grid-cols-3" data-opportunity-gallery={g.id}>
            {g.items.map((item) => (
              <li>
                <figure>
                  <div class="aspect-[4/5] overflow-hidden bg-(--color-ink-soft)">
                    <RemoteImage src={item.src} alt={item.alt[lang]} width={item.width} height={item.height} sizes={GALLERY_SIZES} class="h-full w-full" />
                  </div>
                  {item.caption && <figcaption class="mt-2 text-xs text-(--color-paper)/60">{item.caption[lang]}</figcaption>}
                </figure>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }
</article>
