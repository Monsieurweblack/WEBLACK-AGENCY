---
import RemoteImage from "../media/RemoteImage.astro";
import CardWork from "../cards/CardWork.astro";
import CtaContact from "../sections/CtaContact.astro";
import { useTranslations, localizedPath, type Lang } from "../../i18n/utils";
import { getEntriesByLang, type WorkEntry } from "../../lib/content";

interface Props {
  lang: Lang;
  work: WorkEntry;
}

const { lang, work } = Astro.props;
const t = useTranslations(lang);

const related = work.data.relatedWorkSlugs?.length
  ? (await getEntriesByLang("work", lang)).filter((w) => work.data.relatedWorkSlugs!.includes(w.data.slug))
  : [];
---

<article class="bg-(--color-ink)">
  <header class="relative flex min-h-[60vh] items-end overflow-hidden">
    <div class="absolute inset-0" aria-hidden="true">
      <RemoteImage
        src={work.data.coverImage.url}
        alt=""
        width={2400}
        height={1350}
        loading="eager"
        fetchpriority="high"
        class="h-full w-full opacity-55"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-(--color-ink) via-(--color-ink)/40 to-(--color-ink)/10"></div>
    </div>
    <div class="relative z-10 mx-auto w-full max-w-(--container-content) px-6 pb-16 pt-40 md:px-10">
      <a
        href={localizedPath(lang, "/selected-work")}
        class="label-tracked text-(--color-paper)/60 transition-colors hover:text-(--color-gold)"
      >
        &larr; {t("selectedwork.back")}
      </a>
      <p class="label-tracked label-tracked-dot mt-8 text-(--color-gold)">
        {work.data.client} · {work.data.year} · {work.data.location.city}, {work.data.location.country}
      </p>
      <h1 class="font-display mt-4 max-w-3xl text-4xl text-(--color-paper) sm:text-5xl">
        {work.data.title}
      </h1>
    </div>
  </header>

  <div class="mx-auto max-w-(--container-content) px-6 py-16 md:px-10 md:py-24">
    <div class="grid grid-cols-1 gap-16 lg:grid-cols-[1.4fr_1fr]">
      <div class="space-y-10">
        <div>
          <p class="label-tracked text-(--color-gold)">{t("selectedwork.detail.context")}</p>
          <p class="mt-3 text-(--color-paper)/80">{work.data.context}</p>
        </div>
        <div>
          <p class="label-tracked text-(--color-gold)">{t("selectedwork.detail.challenge")}</p>
          <p class="mt-3 text-(--color-paper)/80">{work.data.challenge}</p>
        </div>
        <div>
          <p class="label-tracked text-(--color-gold)">{t("selectedwork.detail.response")}</p>
          <p class="mt-3 text-(--color-paper)/80">{work.data.creativeResponse}</p>
        </div>
      </div>
      <aside class="space-y-8 lg:pl-8">
        <div class="border-t border-(--color-line) pt-5">
          <p class="label-tracked text-(--color-gold)">{t("selectedwork.detail.role")}</p>
          <p class="mt-2 text-(--color-paper)/80">{work.data.role}</p>
        </div>
        <div class="border-t border-(--color-line) pt-5">
          <p class="label-tracked text-(--color-gold)">{t("selectedwork.detail.disciplines")}</p>
          <p class="mt-2 text-(--color-paper)/80">{work.data.disciplines.join(" · ")}</p>
        </div>
        {
          work.data.results && work.data.results.length > 0 && (
            <div class="border-t border-(--color-line) pt-5">
              <p class="label-tracked text-(--color-gold)">{t("selectedwork.detail.results")}</p>
              <ul class="mt-3 space-y-3">
                {work.data.results.map((result) => (
                  <li class="flex items-start gap-3 text-(--color-paper)/80">
                    <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-(--color-gold)" />
                    {result}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>

    {
      work.data.galleryImages && work.data.galleryImages.length > 0 && (
        <div class="mt-16 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {work.data.galleryImages.map((image) => (
            <div class="aspect-[4/3] overflow-hidden bg-(--color-ink-soft)" data-reveal>
              <RemoteImage src={image.url} alt={image.alt} width={900} height={675} credit={image.credit} class="h-full w-full" />
            </div>
          ))}
        </div>
      )
    }
  </div>

  {
    related.length > 0 && (
      <section class="border-t border-(--color-line) bg-(--color-ink) py-20 md:py-28">
        <div class="mx-auto max-w-(--container-content) px-6 md:px-10">
          <p class="label-tracked text-(--color-gold)">{t("selectedwork.detail.related")}</p>
          <div class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((w, i) => (
              <CardWork lang={lang} work={w} index={i} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaContact lang={lang} />
</article>
