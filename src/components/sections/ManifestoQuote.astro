---
import { useTranslations, type Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
  /** From the "homepage" Sanity singleton — falls back to i18n copy when not set. */
  text?: string;
}

const { lang, text } = Astro.props;
const t = useTranslations(lang);
const manifestoText = text ?? t("home.manifesto");

/**
 * French typographic convention uses « » (with a non-breaking
 * space, so the mark never separates from the text at a line break) rather
 * than the English-style “ ” curly quotes — hardcoding “ ” regardless of
 * language was incorrect on French pages.
 */
const QUOTES: Partial<Record<Lang, [string, string]>> = {
  fr: ["« ", " »"],
};
const [openQuote, closeQuote] = QUOTES[lang] ?? ["“", "”"];
---

{/*
  La conviction, lue au rythme du défilement : la phrase s'encre en
  arrivant au centre de l'écran ([data-read], motion.css — compositeur seul,
  le texte est toujours dans le document, entier et lisible sans support).
  Un seul bloc, jamais découpé mot à mot.
*/}
<section class="bg-(--color-paper) py-32 md:py-44">
  <div class="mx-auto max-w-5xl px-6 text-center md:px-10">
    <p
      data-read
      class="font-display text-balance text-[2rem] leading-[1.2] text-(--color-ink) sm:text-5xl lg:text-[3.6rem] lg:leading-[1.15]"
    >
      {openQuote}{manifestoText}{closeQuote}
    </p>
    <div data-read class="mx-auto mt-10 h-px w-16 bg-(--color-gold)"></div>
  </div>
</section>
