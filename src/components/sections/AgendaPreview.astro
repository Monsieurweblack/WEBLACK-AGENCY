---
import { useTranslations, localizedPath, type Lang } from "../../i18n/utils";
import { getAgendaEvents } from "../../lib/content";
import { dayNumber, shortMonth, placeLine, whoOf } from "../../lib/agenda-format";

interface Props {
  lang: Lang;
  /** Combien de rendez-vous montrer. Trois suffisent à donner le ton sans concurrencer l'article mis en avant. */
  limit?: number;
  /**
   * Sur le Journal, le bloc suit une section qui a déjà son espace bas et
   * n'a donc rien à ajouter au-dessus. Sur l'accueil, il arrive après une
   * section claire et doit respirer.
   */
  standalone?: boolean;
}

const { lang, limit = 3, standalone = false } = Astro.props;
const t = useTranslations(lang);

/**
 * Les prochains rendez-vous, sur une page qui n'est pas l'Agenda.
 *
 * La liste est déjà triée par date et déjà filtrée — vérifiée, à venir,
 * données essentielles présentes. Rien n'est refiltré ici : ce bloc montre
 * le début de l'Agenda, il ne décide de rien.
 *
 * Quand il n'y a rien à annoncer, la section entière disparaît plutôt que
 * d'afficher un cadre vide. Un agenda qui n'a rien à dire ne dit rien.
 */
const events = (await getAgendaEvents(lang)).slice(0, limit);
---

{
  events.length > 0 && (
    <section class:list={["bg-(--color-ink) px-6 pb-20 md:px-10", standalone && "pt-20 md:pt-24"]}>
      <div class="mx-auto max-w-(--container-content)">
        <div class="flex flex-wrap items-baseline justify-between gap-4 border-t border-(--color-line) pt-10" data-reveal>
          <h2 class="label-tracked label-tracked-dot text-(--color-gold)">{t("agenda.hero.eyebrow")}</h2>
          <a
            href={localizedPath(lang, "/agenda/")}
            class="label-tracked text-(--color-paper)/50 transition-colors hover:text-(--color-gold)"
          >
            {t("agenda.fromJournal")} &rarr;
          </a>
        </div>

        <ul class="m-0 mt-2 grid list-none grid-cols-1 gap-x-10 p-0 sm:grid-cols-2 lg:grid-cols-3">
          {events.map((event, index) => (
            <li class:list={["border-t border-(--color-line)", index === 0 && "sm:border-t-0 lg:border-t-0"]}>
              <a href={localizedPath(lang, `/agenda/${event.slug}/`)} class="group block py-8">
                <p class="flex items-baseline gap-2">
                  <span class="font-display text-3xl leading-none text-(--color-gold) tabular-nums">
                    {dayNumber(event.startDate, lang)}
                  </span>
                  <span class="label-tracked text-(--color-paper)/40">{shortMonth(event.startDate, lang)}</span>
                </p>
                <h3 class="font-display mt-4 text-xl text-(--color-paper) transition-colors group-hover:text-(--color-gold)">
                  {event.eventName}
                </h3>
                {whoOf(event) && <p class="mt-2 text-(--color-paper)/70">{whoOf(event)}</p>}
                <p class="mt-2 text-sm text-(--color-paper)/50">{placeLine(event)}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
