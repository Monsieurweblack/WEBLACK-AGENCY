---
import { useTranslations, localizedPath, type Lang } from "../../i18n/utils";
import { getAgendaEvents } from "../../lib/content";
import { dayNumber, shortMonth } from "../../lib/agenda-format";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/**
 * La bande des prochains rendez-vous, sous le hero.
 *
 * Un agenda vit au présent : une ligne qui défile dit cela mieux qu'un
 * cadre immobile. Elle ne porte que l'essentiel — la date, le nom, la
 * ville — et renvoie à l'Agenda pour le reste.
 *
 * Toute la bande est un seul lien. Des liens individuels sur un contenu en
 * mouvement seraient impossibles à viser ; ici, où qu'on clique, on arrive
 * au bon endroit.
 */
const events = await getAgendaEvents(lang);

/** Le défilement dure en proportion du nombre d'entrées, pour garder une vitesse de lecture constante. */
const duration = Math.max(events.length * 9, 30);
---

{
  events.length > 0 && (
    <section class="agenda-ticker border-y border-(--color-line) bg-(--color-ink)" aria-label={t("agenda.hero.eyebrow")}>
      <a
        href={localizedPath(lang, "/agenda/")}
        class="group block overflow-hidden py-5"
        style={`--ticker-duration:${duration}s`}
      >
        <div class="ticker-track flex w-max items-center">
          {/*
            La piste contient deux fois la même liste : la première défile
            hors de l'écran pendant que la seconde prend sa place, et la
            boucle se referme sans saut. La copie est cachée aux lecteurs
            d'écran, qui entendraient sinon l'agenda en double.
          */}
          {[false, true].map((clone) => (
            <ul class="m-0 flex list-none items-center p-0" aria-hidden={clone ? "true" : undefined}>
              <li class="label-tracked shrink-0 px-8 text-(--color-gold)">{t("agenda.hero.eyebrow")}</li>
              {events.map((event) => (
                <li class="flex shrink-0 items-baseline gap-3 px-8">
                  <span class="label-tracked whitespace-nowrap text-(--color-gold) tabular-nums">
                    {dayNumber(event.startDate, lang)} {shortMonth(event.startDate, lang)}
                  </span>
                  <span class="whitespace-nowrap text-(--color-paper) transition-colors group-hover:text-(--color-gold)">
                    {event.eventName}
                  </span>
                  <span class="whitespace-nowrap text-sm text-(--color-paper)/40">{event.city}</span>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </a>
    </section>
  )
}

<style>
  /*
    Le défilement ne s'applique que si le visiteur accepte le mouvement.
    Sinon la bande devient une simple rangée que l'on fait glisser à la
    main : le contenu reste atteignable, ce qui ne serait pas le cas si on
    se contentait de figer une piste deux fois plus large que l'écran.
  */
  @media (prefers-reduced-motion: no-preference) {
    .ticker-track {
      animation: agenda-scroll var(--ticker-duration, 45s) linear infinite;
    }

    /* On s'arrête quand on survole ou quand le clavier atteint la bande, le temps de lire. */
    .agenda-ticker:hover .ticker-track,
    .agenda-ticker:focus-within .ticker-track {
      animation-play-state: paused;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .agenda-ticker a {
      overflow-x: auto;
    }

    .agenda-ticker ul[aria-hidden="true"] {
      display: none;
    }
  }

  @keyframes agenda-scroll {
    from {
      transform: translateX(0);
    }
    to {
      /* La piste porte deux copies : la moitié, c'est exactement une liste. */
      transform: translateX(-50%);
    }
  }
</style>
