---
import CardJournal from "../cards/CardJournal.astro";
import type { JournalEntry } from "../../lib/content";
import { useTranslations, localizedPath, type Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
  articles: JournalEntry[];
}

const { lang, articles } = Astro.props;
const t = useTranslations(lang);
---

{
  articles.length > 0 && (
    <section class="bg-(--color-paper) py-24 md:py-32">
      <div class="on-light-panel mx-auto max-w-(--container-content) px-6 md:px-10">
        <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
          <div class="max-w-2xl">
            <p class="label-tracked label-tracked-dot text-(--color-gold)">{t("home.journal.eyebrow")}</p>
            <h2 class="font-display mt-4 text-4xl text-(--color-ink) sm:text-5xl">{t("home.journal.title")}</h2>
          </div>
          <a
            href={localizedPath(lang, "/journal")}
            class="label-tracked shrink-0 text-(--color-ink)/60 transition-colors hover:text-(--color-gold)"
          >
            {t("home.journal.cta")} &rarr;
          </a>
        </div>

        <div class="mt-14 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3">
          {articles.map((article, i) => (
            <CardJournal lang={lang} article={article} index={i} />
          ))}
        </div>
      </div>
    </section>
  )
}
