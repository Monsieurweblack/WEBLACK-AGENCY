---
import CardWork from "../cards/CardWork.astro";
import SelectedWorkEditorial from "./SelectedWorkEditorial.astro";
import type { WorkEntry } from "../../lib/content";
import { useTranslations, localizedPath, type Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
  work: WorkEntry[];
}

const { lang, work } = Astro.props;
const t = useTranslations(lang);

/**
 * Deux traitements, un seul par appel — jamais un compromis entre les deux.
 *
 * En dessous de trois projets, la grille CardWork (conçue pour trois
 * colonnes et plus) laisse un emplacement visiblement vide : elle rend la
 * rareté de l'inventaire lisible comme un manque plutôt que comme un
 * choix. SelectedWorkEditorial existe pour ce cas précis — voir son
 * commentaire d'en-tête. Elle n'a jamais besoin d'être choisie « en plus » :
 * dès qu'un troisième projet réel sera publié, cette condition bascule
 * d'elle-même vers la grille, déjà conçue pour l'abondance.
 */
const isScarce = work.length > 0 && work.length <= 2;
---

{
  /*
    id="work" sur la section : cible du CTA principal du Hero — un ancrage
    additif, jamais une modification de Work lui-même.
  */
  work.length > 0 && (
    <section id="work" class="bg-(--color-ink) py-24 md:py-32">
      <div class="mx-auto max-w-(--container-content) px-6 md:px-10">
        <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
          <div class="max-w-2xl">
            <p class="label-tracked label-tracked-dot text-(--color-gold)">{t("home.work.eyebrow")}</p>
            <h2 class="font-display mt-4 text-4xl text-(--color-paper) sm:text-5xl">{t("home.work.title")}</h2>
            <p class="mt-4 max-w-lg text-(--color-paper)/70">{t("home.work.lead")}</p>
          </div>
          <a
            href={localizedPath(lang, "/selected-work")}
            class="label-tracked shrink-0 text-(--color-paper)/60 transition-colors hover:text-(--color-gold)"
          >
            {t("home.work.cta")} &rarr;
          </a>
        </div>

        {isScarce ? (
          <SelectedWorkEditorial lang={lang} work={work} />
        ) : (
          <div class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {work.map((item, i) => (
              <CardWork lang={lang} work={item} index={i} />
            ))}
          </div>
        )}

        {/*
          Transition vers Practice — la preuve qu'on vient de montrer appelle
          la question suivante : comment WEBLACK opère. #practice ancre sur
          la section Divisions (voir DivisionsGrid.astro), juste en dessous.
        */}
        <a
          href="#practice"
          class="label-tracked mt-16 flex items-center justify-center gap-2 border-t border-(--color-line) pt-10 text-(--color-paper)/50 transition-colors hover:text-(--color-gold)"
          data-reveal
        >
          {t("home.work.practiceLink")}
          <span aria-hidden="true">&darr;</span>
        </a>
      </div>
    </section>
  )
}
