---
import { useTranslations, defaultLang, type Lang } from "../../i18n/utils";
import { founderBio } from "../../data/founder-bio";
import type { TeamMemberData } from "../../lib/content";

interface Props {
  lang: Lang;
  /** From the `teamMember` Sanity type — falls back to src/data/founder-bio.ts when not set or incomplete. */
  member?: TeamMemberData;
}

const { lang, member } = Astro.props;
const t = useTranslations(lang);
// nb/zh have no bio content yet and fall back to the French text — the
// quote marks must match whichever language the *quoted text* is actually
// in, not the page's own lang, or a French quote would render inside
// English-style curly quotes on an nb/zh page.
const bioLang = founderBio[lang] ? lang : defaultLang;
const fallbackBio = founderBio[bioLang]!;

const hasSanityBio = Boolean(member?.bioHtml && member?.quote);
const name = member?.name ?? fallbackBio.name;
const role = member?.role ?? t("about.founder.role");
const quote = member?.quote ?? fallbackBio.quote;
const quoteAttribution = member?.quoteAttribution ?? fallbackBio.quoteAttribution;

/**
 * French typographic convention uses « » (with a non-breaking space) rather
 * than the English-style “ ” curly quotes hardcoded here previously.
 */
const [openQuote, closeQuote]: [string, string] = bioLang === "fr" ? ["« ", " »"] : ["“", "”"];
---

<div
  id="founder-bio-panel"
  class="fixed inset-0 z-[60] overflow-y-auto bg-(--color-ink)/97 opacity-0 pointer-events-none backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="founder-bio-heading"
  aria-hidden="true"
  inert
  data-founder-bio-panel
>
  <div class="relative mx-auto min-h-full w-full max-w-(--container-content) px-6 pb-24 pt-28 md:px-10 md:pt-32">
    <button
      type="button"
      class="label-tracked absolute right-6 top-8 inline-flex items-center gap-3 border border-(--color-line) px-4 py-2 text-(--color-paper) transition-colors duration-300 hover:border-(--color-gold) hover:text-(--color-gold) md:right-10"
      data-founder-bio-close
    >
      {t("nav.close")}
      <span aria-hidden="true">&times;</span>
    </button>

    <div class="max-w-3xl">
      <p class="label-tracked label-tracked-dot text-(--color-gold)">{t("about.founder.eyebrow")}</p>
      <h2 id="founder-bio-heading" class="font-display mt-4 text-4xl text-(--color-paper) sm:text-5xl">
        {name}
      </h2>
      <p class="label-tracked mt-3 text-(--color-paper)/50">{role}</p>

      {hasSanityBio ? (
        <div class="prose-weblack prose-weblack--ink mt-10 max-w-none" set:html={member!.bioHtml} />
      ) : (
        <div class="mt-10 space-y-6 text-(--color-paper)/80">
          {fallbackBio.paragraphs.slice(0, 2).map((paragraph) => <p>{paragraph}</p>)}
        </div>
      )}

      {hasSanityBio && member!.gallery.length > 0 ? (
        <div class="mt-10 grid grid-cols-2 gap-4">
          {member!.gallery.map((photo) => (
            <figure class="overflow-hidden">
              <img src={photo.url} alt={photo.alt} loading="lazy" class="aspect-[3/4] w-full object-cover" />
              {photo.caption && <figcaption class="label-tracked mt-2 text-xs text-(--color-paper)/45">{photo.caption}</figcaption>}
            </figure>
          ))}
        </div>
      ) : !hasSanityBio && fallbackBio.photos.length > 0 ? (
        <div class="mt-10 grid grid-cols-2 gap-4">
          {fallbackBio.photos.map((photo) => (
            <figure class:list={["overflow-hidden", { "col-span-2": photo.wide }]}>
              <img
                src={photo.src}
                alt={photo.alt}
                loading="lazy"
                class:list={["w-full object-cover", photo.wide ? "aspect-[16/10]" : "aspect-[3/4]"]}
              />
              <figcaption class="label-tracked mt-2 text-xs text-(--color-paper)/45">{photo.caption}</figcaption>
            </figure>
          ))}
        </div>
      ) : null}

      {!hasSanityBio && (
        <div class="mt-10 space-y-6 text-(--color-paper)/80">
          {fallbackBio.paragraphs.slice(2).map((paragraph) => <p>{paragraph}</p>)}
        </div>
      )}

      <blockquote class="mt-12 border-l-2 border-(--color-gold) pl-6 md:pl-8">
        <p class="font-display text-2xl italic leading-snug text-(--color-paper) sm:text-3xl">
          {openQuote}{quote}{closeQuote}
        </p>
        <cite class="label-tracked mt-4 block not-italic text-(--color-gold)">{quoteAttribution}</cite>
      </blockquote>
    </div>
  </div>
</div>

<script>
  import { initFounderBio } from "../../scripts/founder-bio";
  initFounderBio();
</script>
