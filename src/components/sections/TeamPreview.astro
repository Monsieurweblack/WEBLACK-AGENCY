---
import RemoteImage from "../media/RemoteImage.astro";
import { useTranslations, localizedPath, type Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const teamAnchor = lang === "fr" ? "equipe" : "team";
---

<section class="bg-(--color-ink) py-24 md:py-32">
  <div class="mx-auto max-w-(--container-content) px-6 md:px-10">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div class="max-w-2xl">
        <p class="label-tracked label-tracked-dot text-(--color-gold)">{t("home.team.eyebrow")}</p>
        <h2 class="font-display mt-4 text-4xl text-(--color-paper) sm:text-5xl">
          {t("home.team.title")}
        </h2>
      </div>
      <a
        href={`${localizedPath(lang, "/about")}#${teamAnchor}`}
        class="label-tracked shrink-0 text-(--color-paper)/60 transition-colors hover:text-(--color-gold)"
      >
        {t("home.team.cta")} &rarr;
      </a>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-10 sm:grid-cols-3" data-reveal data-reveal-delay="0.1">
      <div>
        <div class="aspect-[3/4] overflow-hidden bg-(--color-ink-soft)">
          <RemoteImage
            src="/photos/founder-deo-gratias-kpodo.png"
            alt={t("about.founder.name")}
            width={1088}
            height={1446}
            class="h-full w-full object-cover"
            sizes="(min-width: 640px) 33vw, 100vw"
          />
        </div>
        <h3 class="font-display mt-5 text-xl text-(--color-paper)">{t("about.founder.name")}</h3>
        <p class="label-tracked mt-1 text-(--color-gold)/80">{t("about.founder.role")}</p>
      </div>
    </div>
  </div>
</section>
