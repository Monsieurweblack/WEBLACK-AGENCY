---
import { getImage } from "astro:assets";
import weblackSymbol from "../../assets/logo/weblack-symbol-clean.png";
import { useTranslations, localizedPath, type Lang } from "../../i18n/utils";
import type { HomepageHero } from "../../lib/content";

interface Props {
  lang: Lang;
  /** From the "homepage" Sanity singleton — falls back to i18n copy below when a field isn't set. */
  hero?: HomepageHero;
}

const { lang, hero } = Astro.props;
// Le symbole n'est utilisé que comme masque CSS (seul son canal alpha
// compte) : WebP généré à la compilation (canal alpha encodé sans perte,
// alphaQuality 100 par défaut) au lieu du PNG de 190 Ko, mêmes dimensions,
// même alpha.
const symbolMask = await getImage({ src: weblackSymbol, format: "webp", quality: 100 });
const maskStyle = `-webkit-mask-image: url(${symbolMask.src}); mask-image: url(${symbolMask.src});`;
const t = useTranslations(lang);

const tagline = hero?.eyebrow ?? t("home.hero.tagline");
const pillars = hero?.subtitle ?? t("home.hero.pillars");
const ctaExploreLabel = hero?.ctaPrimaryLabel ?? t("home.hero.cta.explore");
/**
 * Le repli par défaut n'est pas /about : le Hero installe la marque ;
 * la découverte qu'il promet, dans l'architecture de l'accueil, c'est la
 * page elle-même. #work garde le visiteur dans la page et l'amène
 * directement à la preuve — la première chose que l'architecture veut
 * montrer après l'identité.
 */
const ctaExploreHref = localizedPath(lang, hero?.ctaPrimaryUrl ?? "#work");

/**
 * Le CTA secondaire n'a pas de repli i18n : il ne s'affiche que si un
 * contenu Sanity l'active explicitement (label ET destination). Le header
 * reste l'unique entrée commerciale persistante.
 */
const hasSecondaryCta = Boolean(hero?.ctaSecondaryLabel && hero?.ctaSecondaryUrl);
const ctaWorkLabel = hero?.ctaSecondaryLabel;
const ctaWorkHref = hero?.ctaSecondaryUrl ? localizedPath(lang, hero.ctaSecondaryUrl) : undefined;
---

{/*
  Le Hero : un noir profond, une lumière, le monogramme. Aucune photographie
  ici, par décision de direction artistique (2026-11-04) : la photo du public
  (champ « heroImage » de la page d'accueil dans Sanity, repli
  /photos/hero-home.jpg) mettait un projecteur et des silhouettes derrière le
  texte — du bruit, pas de la profondeur. La photographie arrive pleine page
  juste après, dans les chapitres (DivisionsChapters.astro), où elle est le
  sujet et non un fond.

  La lumière est le fond de la section lui-même (dégradés, voir <style>) :
  aucune couche plein écran superposée, aucun grain (mesuré : la trame de
  grain était la couche la plus coûteuse du Hero, pour un effet à 3,5 %
  d'opacité), aucun filtre de flou.
*/}
{/*
  Masque du W : pas de préchargement. Mesuré le 2026-11-05 (Lighthouse
  mobile simulé, A/B intercalé) : sur /en/, où le W est l'élément LCP, le
  préchargement ne changeait pas le LCP (3927 contre 3920 ms) ; sur /, il
  entrait en concurrence avec le premier rendu (FCP 1,55 → 2,01 s contre la
  production). Le masque est demandé par la feuille de style, comme en
  production.
*/}
<section data-hero-section class="hero-stage relative flex min-h-[100svh] items-start overflow-hidden lg:items-end">
  {/*
    Placement inchangé depuis la production : top calé sur --header-h
    (l'en-tête change de hauteur sous 767px), largeur unique dans
    --hero-symbol-w, que le bloc de texte réutilise pour se placer sous le
    symbole sans jamais le chevaucher (voir <style>).
  */}
  <div
    class="pointer-events-none absolute inset-x-0 top-[calc(var(--header-h)+var(--hero-safe-gap))] z-[4] mx-auto w-(--hero-symbol-w) lg:inset-x-auto lg:right-[9%] xl:right-[8%] lg:top-1/2 lg:mx-0 lg:w-[36vw] lg:max-w-[620px] xl:w-[40vw] xl:max-w-[700px] lg:-translate-y-1/2"
    aria-hidden="true"
  >
    {/*
      Le monogramme vivant — trois étages, chacun avec un seul rôle :
        .mark-recede  s'éloigne quand le Hero quitte l'écran (défilement, CSS) ;
        .mark-tilt    perspective du curseur / du toucher (monogram.ts écrit
                      directement son transform : un seul élément restylé) ;
        couches       deux tranches dorées sombres en retrait (translateZ) =
                      l'épaisseur du métal, déployées au réveil du W et
                      visibles quand il pivote ; la face porte le reflet
                      (.mark-sheen), qui glisse en transform.
      Tout ce qui bouge est transform ou opacity sur une couche peinte une
      seule fois : aucune image du W n'est repeinte pendant le mouvement.
    */}
    <div class="mark-recede">
      <div data-mark-tilt class="mark-tilt" style={`aspect-ratio: ${weblackSymbol.width} / ${weblackSymbol.height};`}>
        <div class="mark-layer mark-depth" style={`--z: -26px; --dy: 3px; ${maskStyle}`}></div>
        <div class="mark-layer mark-depth mark-depth-near" style={`--z: -13px; --dy: 1.5px; ${maskStyle}`}></div>
        <div data-hero-mark class="mark-layer mark-face" style={maskStyle}>
          <span data-mark-sheen class="mark-sheen"></span>
        </div>
      </div>
    </div>
  </div>

  <div
    class="relative z-10 mx-auto w-full max-w-(--container-content) px-6 pb-[clamp(0.25rem,3svh,6rem)] pt-[calc(var(--header-h)+var(--hero-safe-gap)+var(--hero-symbol-h)+var(--hero-safe-gap))] md:px-10 md:pb-32 lg:pt-40"
  >
    <h1
      data-intro="title"
      class="font-display text-balance text-[clamp(2.25rem,10svh,3.75rem)] leading-[0.95] text-(--color-paper) sm:text-[clamp(1.875rem,10svh,6rem)] lg:text-9xl"
    >
      WEBLACK
    </h1>
    <p data-intro style="--intro-i: 1" class="label-tracked label-tracked-dot mt-[clamp(0.25rem,2svh,1.5rem)] text-(--color-gold) lg:mt-6">{tagline}</p>
    {/* La phrase des piliers n'est pas animée : c'est l'élément LCP de l'accueil. */}
    <p
      data-hero-pillars
      class="font-display mt-[clamp(0.25rem,1.5svh,1rem)] max-w-xl text-balance text-2xl text-(--color-paper)/85 sm:text-3xl lg:mt-4"
    >
      {pillars}
    </p>
    <div data-intro style="--intro-i: 3" class="mt-[clamp(0.5rem,3svh,2.5rem)] flex flex-wrap items-center gap-4 lg:mt-10">
      <a
        href={ctaExploreHref}
        data-press
        class="cta-arrow inline-flex items-center justify-center gap-3 bg-(--color-gold) px-7 py-3.5 text-sm font-semibold uppercase tracking-[0.08em] text-(--color-on-gold) transition-[background-color] duration-300 hover:bg-(--color-gold-bright)"
      >
        {ctaExploreLabel}
        <span aria-hidden="true" class="cta-arrow-glyph">&rarr;</span>
      </a>
      {hasSecondaryCta && (
        <a
          href={ctaWorkHref}
          data-press
          class="inline-flex items-center justify-center border border-(--color-paper)/40 px-7 py-3.5 text-sm font-semibold uppercase tracking-[0.08em] text-(--color-paper) transition-[border-color] duration-300 hover:border-(--color-paper)"
        >
          {ctaWorkLabel}
        </a>
      )}
    </div>
  </div>

  <a
    href="#work"
    class="group absolute bottom-8 left-6 z-10 hidden items-center gap-3 text-(--color-paper)/50 transition-colors duration-300 hover:text-(--color-paper)/80 focus-visible:text-(--color-paper) md:left-10 md:flex lg:bottom-12"
  >
    <span class="relative h-10 w-px overflow-hidden bg-(--color-paper)/20" aria-hidden="true">
      <span class="scroll-cue-dot absolute inset-x-0 top-0 h-3 bg-(--color-paper)/70"></span>
    </span>
    <span class="label-tracked">{t("home.hero.scroll")}</span>
  </a>
</section>

<script>
  import { initMonogram } from "../../scripts/motion/monogram";

  const section = document.querySelector<HTMLElement>("[data-hero-section]");
  if (section) initMonogram(section);
</script>

<style>
  /*
   * Source unique pour la largeur du symbole (mobile/tablette) et
   * l'espacement de respiration, réutilisées telles quelles par le bloc de
   * texte pour calculer sa propre position : les deux ne peuvent jamais
   * diverger. Le plafond en px est dans la valeur elle-même (min()), pour
   * que la hauteur dérivée corresponde toujours au symbole réellement
   * affiché. --hero-symbol-h : le fichier source fait 735×720 px.
   * Sous 750 px de hauteur, un plafond en svh protège le titre et l'appel
   * (paysage téléphone) ; au-delà, la largeur gouverne seule.
   */
  [data-hero-section] {
    --hero-symbol-w: min(62vw, 340px);
    --hero-symbol-h: calc(var(--hero-symbol-w) * 0.9796);
    --hero-safe-gap: clamp(0.125rem, 1svh, 1.5rem);
  }

  @media (min-width: 768px) {
    [data-hero-section] {
      --hero-symbol-w: min(46vw, 480px);
    }
  }

  @media (max-height: 750px) {
    [data-hero-section] {
      --hero-symbol-w: min(62vw, 340px, 16svh);
    }
  }

  @media (max-height: 750px) and (min-width: 768px) {
    [data-hero-section] {
      --hero-symbol-w: min(46vw, 480px, 16svh);
    }
  }

  @media (max-height: 450px) {
    [data-hero-section] {
      --hero-symbol-w: min(62vw, 340px, 10svh);
    }

    /* Paysage téléphone le plus court : la phrase des piliers tient en deux lignes. */
    [data-hero-pillars] {
      max-width: none;
      font-size: 1.5rem;
    }
  }

  @media (max-height: 450px) and (min-width: 768px) {
    [data-hero-section] {
      --hero-symbol-w: min(46vw, 480px, 10svh);
    }
  }

  /*
   * La lumière, peinte une fois dans le fond de la section : un halo doré
   * là où se tient le W, une douche de lumière froide venue d'en haut (le
   * plateau, pas le soleil), un vignettage qui creuse les bords. Thème
   * clair : le halo seul, sans assombrissement.
   */
  .hero-stage {
    --halo: 50% calc(var(--header-h, 6rem) + var(--hero-symbol-h) * 0.5);
    background:
      radial-gradient(38% 30% at var(--halo), color-mix(in srgb, var(--color-gold) 14%, transparent), transparent 72%),
      radial-gradient(70% 45% at 50% -8%, rgb(255 255 255 / 5%), transparent 70%),
      radial-gradient(130% 95% at 50% 38%, transparent 52%, rgb(0 0 0 / 62%)),
      var(--color-ink);
  }

  @media (min-width: 1024px) {
    .hero-stage {
      --halo: 72% 50%;
      background:
        radial-gradient(30% 42% at var(--halo), color-mix(in srgb, var(--color-gold) 13%, transparent), transparent 72%),
        radial-gradient(50% 50% at 72% -12%, rgb(255 255 255 / 5%), transparent 70%),
        radial-gradient(120% 100% at 60% 45%, transparent 50%, rgb(0 0 0 / 65%)),
        var(--color-ink);
    }
  }

  :global(:root[data-theme="light"]) .hero-stage {
    background:
      radial-gradient(40% 40% at var(--halo), color-mix(in srgb, var(--color-gold) 12%, transparent), transparent 72%),
      var(--color-ink);
  }

  /* — Le monogramme — */

  .mark-tilt {
    position: relative;
    transform: perspective(1100px);
    transform-style: preserve-3d;
  }

  .mark-layer {
    position: absolute;
    inset: 0;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
  }

  /* L'or de la face : une lumière haute à gauche, l'ombre en bas à droite. */
  .mark-face {
    background:
      linear-gradient(160deg, rgb(255 246 226 / 22%), transparent 38%),
      radial-gradient(circle at 34% 26%, var(--color-gold-bright), var(--color-gold) 52%, var(--color-gold-dim) 100%);
  }

  /*
   * L'épaisseur : le métal vu de biais, plus sombre à mesure qu'il recule.
   * Repliée derrière la face au premier rendu ; elle se déploie au réveil
   * du W ([data-awake], posé par monogram.ts une fois la page chargée) —
   * une transition de transform, jamais pendant l'analyse de la page.
   */
  .mark-depth {
    background: linear-gradient(180deg, var(--color-gold-dim), color-mix(in srgb, var(--color-gold-dim) 45%, #000));
    transition: transform 1600ms var(--ease-signature);
  }

  [data-awake] .mark-depth {
    transform: translate3d(0, var(--dy), var(--z));
  }

  .mark-depth-near {
    background: linear-gradient(180deg, var(--color-gold), var(--color-gold-dim));
  }

  /* Le reflet : une lame de lumière en diagonale, qui ne vit que sur la face (le masque la découpe). */
  .mark-sheen {
    position: absolute;
    inset: -10% -70%;
    background: linear-gradient(
      105deg,
      transparent 43%,
      rgb(255 243 220 / 62%) 50%,
      transparent 57%
    );
    opacity: 0;
    transform: translateX(-45%);
  }

  /*
   * Le réveil : le W est là dès la première image ; quand la page a fini de
   * se charger, ses tranches se déploient (ci-dessus) et une seule lame de
   * lumière le traverse. Mesuré : lancée pendant l'analyse de la page,
   * l'ouverture alourdissait les trames les plus longues du chargement.
   */
  @media (prefers-reduced-motion: no-preference) {
    [data-awake] .mark-sheen {
      animation: mark-sheen-pass 1500ms cubic-bezier(0.45, 0, 0.2, 1) 350ms;
    }

    /* L'invitation à défiler : trois passages, puis elle se tait. */
    [data-awake] .scroll-cue-dot {
      animation: scroll-cue 2400ms var(--ease-signature) 900ms 3;
    }
  }

  /*
   * Le W s'éloigne à mesure que le Hero quitte l'écran : animation liée au
   * défilement, calculée hors du fil principal. Propriétés détaillées
   * uniquement (voir motion.css : le raccourci complet est rejeté par
   * Chrome une fois minifié).
   */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      [data-hero-section] {
        view-timeline-name: --hero;
      }

      .mark-recede {
        animation-name: mark-recede;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --hero;
        animation-range: exit 0% exit 90%;
      }
    }
  }

  @keyframes mark-sheen-pass {
    0% {
      opacity: 0;
      transform: translateX(-45%);
    }
    20%,
    75% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(45%);
    }
  }

  @keyframes mark-recede {
    to {
      opacity: 0.2;
      transform: translateY(-10%) scale(0.86);
    }
  }

  @keyframes scroll-cue {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(340%);
    }
  }

  /* Flèche de l'appel : elle avance d'un pas au survol, au clavier comme à la souris. */
  .cta-arrow-glyph {
    display: inline-block;
    transition: transform var(--motion-fast, 240ms) var(--ease-signature);
  }

  .cta-arrow:hover .cta-arrow-glyph,
  .cta-arrow:focus-visible .cta-arrow-glyph {
    transform: translateX(4px);
  }
</style>
