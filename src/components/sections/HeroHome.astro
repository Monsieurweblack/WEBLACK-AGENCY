---
import RemoteImage from "../media/RemoteImage.astro";
import weblackSymbol from "../../assets/logo/weblack-symbol-clean.png";
import { useTranslations, localizedPath, type Lang } from "../../i18n/utils";
import type { HomepageHero } from "../../lib/content";

interface Props {
  lang: Lang;
  heroImage: {
    url: string;
    alt: string;
    width: number;
    height: number;
    credit?: { photographer: string; photographerUrl?: string };
  };
  /** From the "homepage" Sanity singleton — falls back to i18n copy below when a field isn't set. */
  hero?: HomepageHero;
}

const { lang, heroImage, hero } = Astro.props;
const t = useTranslations(lang);

const tagline = hero?.eyebrow ?? t("home.hero.tagline");
const pillars = hero?.subtitle ?? t("home.hero.pillars");
const ctaExploreLabel = hero?.ctaPrimaryLabel ?? t("home.hero.cta.explore");
const ctaExploreHref = localizedPath(lang, hero?.ctaPrimaryUrl ?? "/about");
const ctaWorkLabel = hero?.ctaSecondaryLabel ?? t("home.hero.cta.work");
const ctaWorkHref = localizedPath(lang, hero?.ctaSecondaryUrl ?? "/contact");
---

<section
  data-hero-section
  class="relative flex min-h-[100svh] items-end overflow-hidden bg-(--color-ink)"
>
  <div class="absolute inset-0" aria-hidden="true">
    <RemoteImage
      src={heroImage.url}
      alt=""
      width={heroImage.width}
      height={heroImage.height}
      loading="eager"
      fetchpriority="high"
      class="h-full w-full opacity-45"
      sizes="100vw"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-(--color-ink) via-(--color-ink)/60 to-(--color-ink)/20"
    >
    </div>
    <div class="absolute inset-0 bg-(--color-ink)/20"></div>
  </div>

  <div
    class="pointer-events-none absolute inset-x-0 top-[6%] z-[4] mx-auto w-[52vw] max-w-[300px] opacity-80 sm:top-[10%] sm:w-[44vw] sm:max-w-[420px] sm:opacity-90 lg:inset-x-auto lg:right-[9%] lg:top-1/2 lg:mx-0 lg:w-[36vw] lg:max-w-[620px] lg:-translate-y-1/2 lg:opacity-100"
    aria-hidden="true"
  >
    <div class="absolute inset-0 -z-10 rounded-full bg-(--color-gold)/10 blur-[70px]"></div>
    <span data-hero-ring aria-hidden="true"></span>
    <div
      data-hero-mark
      style={`aspect-ratio: ${weblackSymbol.width} / ${weblackSymbol.height}; -webkit-mask-image: url(${weblackSymbol.src}); mask-image: url(${weblackSymbol.src});`}
      class="hero-symbol w-full drop-shadow-[0_35px_70px_rgba(0,0,0,0.55)]"
    >
    </div>
  </div>

  <div
    class="relative z-10 mx-auto w-full max-w-(--container-content) px-6 pb-24 pt-40 md:px-10 md:pb-32"
  >
    <h1
      class="font-display text-balance text-6xl leading-[0.95] text-(--color-paper) sm:text-8xl lg:text-9xl"
    >
      WEBLACK
    </h1>
    <p class="label-tracked label-tracked-dot mt-6 text-(--color-gold)">{tagline}</p>
    <p class="font-display mt-4 max-w-xl text-balance text-2xl text-(--color-paper)/85 sm:text-3xl">
      {pillars}
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href={ctaExploreHref}
        class="inline-flex items-center justify-center bg-(--color-gold) px-7 py-3.5 text-sm font-semibold uppercase tracking-[0.08em] text-(--color-on-gold) transition-[background-color,transform] duration-300 hover:-translate-y-0.5 hover:bg-(--color-gold-bright)"
      >
        {ctaExploreLabel}
      </a>
      <a
        href={ctaWorkHref}
        class="inline-flex items-center justify-center border border-(--color-paper)/40 px-7 py-3.5 text-sm font-semibold uppercase tracking-[0.08em] text-(--color-paper) transition-[border-color,transform] duration-300 hover:-translate-y-0.5 hover:border-(--color-paper)"
      >
        {ctaWorkLabel}
      </a>
    </div>
  </div>

  <div
    class="pointer-events-none absolute bottom-8 left-6 z-10 hidden items-center gap-3 text-(--color-paper)/50 md:left-10 md:flex"
  >
    <span class="h-10 w-px bg-(--color-paper)/30"></span>
    <span class="label-tracked">{t("home.hero.scroll")}</span>
  </div>
</section>

<style>
  .hero-symbol {
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
    background: radial-gradient(
      circle at 35% 28%,
      var(--color-gold-bright),
      var(--color-gold) 55%,
      var(--color-gold-dim) 100%
    );
  }

  /*
   * The symbol is a single flattened image (W + its thin circle baked into
   * one alpha mask, no separable layers) — isolating just the circle would
   * mean reconstructing the artwork from an approximation, which risks
   * visible degradation of the mark. Instead the W stays completely
   * untouched and static, and an independent ring sits behind it, sized and
   * centered to match the circle's actual footprint in the source file
   * (measured from the asset's own alpha channel: a ~618px circle centered
   * at roughly 50%/47.5% of the 735x720 frame, i.e. ~84% of its width).
   * Rotation is transform-only, so it's cheap and covered by the site's
   * existing global prefers-reduced-motion rule (global.css forces
   * animation-duration to ~0 for every element under that setting).
   */
  [data-hero-ring] {
    position: absolute;
    left: 50%;
    top: 47.5%;
    width: 84%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 9999px;
    background: conic-gradient(
      from 0deg,
      color-mix(in srgb, var(--color-gold) 30%, transparent) 0deg,
      color-mix(in srgb, var(--color-gold) 30%, transparent) 330deg,
      var(--color-gold) 344deg,
      var(--color-gold-bright) 356deg,
      color-mix(in srgb, var(--color-gold) 30%, transparent) 360deg
    );
    -webkit-mask-image: radial-gradient(closest-side, transparent calc(100% - 2px), #000 calc(100% - 2px));
    mask-image: radial-gradient(closest-side, transparent calc(100% - 2px), #000 calc(100% - 2px));
    animation: hero-ring-spin 22s linear infinite;
    will-change: transform;
  }

  @keyframes hero-ring-spin {
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  @media (max-width: 640px) {
    [data-hero-ring] {
      opacity: 0.75;
    }
  }
</style>
