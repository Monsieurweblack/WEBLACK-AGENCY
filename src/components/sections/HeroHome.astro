---
import RemoteImage from "../media/RemoteImage.astro";
import weblackSymbol from "../../assets/logo/weblack-symbol-clean.png";
import { useTranslations, localizedPath, type Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
  heroImage: {
    url: string;
    alt: string;
    width: number;
    height: number;
    credit?: { photographer: string; photographerUrl?: string };
  };
}

const { lang, heroImage } = Astro.props;
const t = useTranslations(lang);
---

<section
  data-hero-section
  class="relative flex min-h-[100svh] items-end overflow-hidden bg-(--color-ink)"
>
  <div class="absolute inset-0" aria-hidden="true">
    <RemoteImage
      src={heroImage.url}
      alt=""
      width={heroImage.width}
      height={heroImage.height}
      loading="eager"
      fetchpriority="high"
      class="h-full w-full opacity-45"
      sizes="100vw"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-(--color-ink) via-(--color-ink)/60 to-(--color-ink)/20"
    >
    </div>
    <div class="absolute inset-0 bg-(--color-ink)/20"></div>
  </div>

  <div
    class="pointer-events-none absolute inset-x-0 top-[6%] z-[4] mx-auto w-[52vw] max-w-[300px] opacity-80 sm:top-[10%] sm:w-[44vw] sm:max-w-[420px] sm:opacity-90 lg:inset-x-auto lg:right-[9%] lg:top-1/2 lg:mx-0 lg:w-[36vw] lg:max-w-[620px] lg:-translate-y-1/2 lg:opacity-100"
    aria-hidden="true"
  >
    <div class="absolute inset-0 -z-10 rounded-full bg-(--color-gold)/10 blur-[70px]"></div>
    <div
      data-hero-mark
      style={`aspect-ratio: ${weblackSymbol.width} / ${weblackSymbol.height}; -webkit-mask-image: url(${weblackSymbol.src}); mask-image: url(${weblackSymbol.src});`}
      class="hero-symbol w-full drop-shadow-[0_35px_70px_rgba(0,0,0,0.55)]"
    >
    </div>
  </div>

  <div
    class="relative z-10 mx-auto w-full max-w-(--container-content) px-6 pb-24 pt-40 md:px-10 md:pb-32"
  >
    <h1
      class="font-display text-balance text-6xl leading-[0.95] text-(--color-paper) sm:text-8xl lg:text-9xl"
    >
      WEBLACK
    </h1>
    <p class="label-tracked label-tracked-dot mt-6 text-(--color-gold)">{t("home.hero.tagline")}</p>
    <p class="font-display mt-4 max-w-xl text-balance text-2xl text-(--color-paper)/85 sm:text-3xl">
      {t("home.hero.pillars")}
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href={localizedPath(lang, "/about")}
        class="inline-flex items-center justify-center bg-(--color-gold) px-7 py-3.5 text-sm font-semibold uppercase tracking-[0.08em] text-(--color-on-gold) transition-colors duration-300 hover:bg-(--color-gold-bright)"
      >
        {t("home.hero.cta.explore")}
      </a>
      <a
        href={localizedPath(lang, "/contact")}
        class="inline-flex items-center justify-center border border-(--color-paper)/40 px-7 py-3.5 text-sm font-semibold uppercase tracking-[0.08em] text-(--color-paper) transition-colors duration-300 hover:border-(--color-paper)"
      >
        {t("home.hero.cta.work")}
      </a>
    </div>
  </div>

  <div
    class="pointer-events-none absolute bottom-8 left-6 z-10 hidden items-center gap-3 text-(--color-paper)/50 md:left-10 md:flex"
  >
    <span class="h-10 w-px bg-(--color-paper)/30"></span>
    <span class="label-tracked">{t("home.hero.scroll")}</span>
  </div>
</section>

<style>
  .hero-symbol {
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
    background: radial-gradient(
      circle at 35% 28%,
      var(--color-gold-bright),
      var(--color-gold) 55%,
      var(--color-gold-dim) 100%
    );
  }

  [data-hero-mark] {
    animation: hero-mark-drift 32s ease-in-out infinite;
  }

  @keyframes hero-mark-drift {
    0%,
    100% {
      transform: rotate(-0.5deg) scale(1);
    }
    50% {
      transform: rotate(0.5deg) scale(1.008);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-hero-mark] {
      animation: none;
    }
  }
</style>
