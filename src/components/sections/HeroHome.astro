---
import RemoteImage from "../media/RemoteImage.astro";
import { useTranslations, localizedPath, type Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
  heroImage: {
    url: string;
    alt: string;
    width: number;
    height: number;
    credit?: { photographer: string; photographerUrl?: string };
  };
}

const { lang, heroImage } = Astro.props;
const t = useTranslations(lang);
---

<section
  data-hero-section
  class="relative flex min-h-[100svh] items-end overflow-hidden bg-(--color-ink)"
>
  <div class="absolute inset-0" aria-hidden="true">
    <RemoteImage
      src={heroImage.url}
      alt=""
      width={heroImage.width}
      height={heroImage.height}
      loading="eager"
      fetchpriority="high"
      class="h-full w-full opacity-45"
      sizes="100vw"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-(--color-ink) via-(--color-ink)/60 to-(--color-ink)/20"
    >
    </div>
    <div class="absolute inset-0 bg-(--color-ink)/20"></div>
  </div>

  <div class="pointer-events-none absolute inset-0" data-hero-canvas-wrap aria-hidden="true">
    <canvas id="hero-canvas" class="h-full w-full"></canvas>
  </div>

  <div
    class="relative z-10 mx-auto w-full max-w-(--container-content) px-6 pb-24 pt-40 md:px-10 md:pb-32"
  >
    <h1
      class="font-display text-balance text-6xl leading-[0.95] text-(--color-paper) sm:text-8xl lg:text-9xl"
    >
      WEBLACK
    </h1>
    <p class="label-tracked label-tracked-dot mt-6 text-(--color-gold)">{t("home.hero.tagline")}</p>
    <p class="font-display mt-4 max-w-xl text-balance text-2xl text-(--color-paper)/85 sm:text-3xl">
      {t("home.hero.pillars")}
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href={localizedPath(lang, "/about")}
        class="inline-flex items-center justify-center bg-(--color-gold) px-7 py-3.5 text-sm font-semibold uppercase tracking-[0.08em] text-(--color-ink) transition-colors duration-300 hover:bg-(--color-gold-bright)"
      >
        {t("home.hero.cta.explore")}
      </a>
      <a
        href={localizedPath(lang, "/contact")}
        class="inline-flex items-center justify-center border border-(--color-paper)/40 px-7 py-3.5 text-sm font-semibold uppercase tracking-[0.08em] text-(--color-paper) transition-colors duration-300 hover:border-(--color-paper)"
      >
        {t("home.hero.cta.work")}
      </a>
    </div>
  </div>

  <div
    class="pointer-events-none absolute bottom-8 left-6 z-10 hidden items-center gap-3 text-(--color-paper)/50 md:left-10 md:flex"
  >
    <span class="h-10 w-px bg-(--color-paper)/30"></span>
    <span class="label-tracked">{t("home.hero.scroll")}</span>
  </div>
</section>

<script>
  import { initHeroScene } from "../../scripts/three/hero-scene";

  const canvas = document.getElementById("hero-canvas") as HTMLCanvasElement | null;
  if (canvas) {
    initHeroScene(canvas).catch(() => {
      canvas.style.display = "none";
    });
  }
</script>
