---
import { useTranslations, type Lang, type UiKey } from "../../i18n/utils";
import { getOngoingEvents, getNowSignals } from "../../lib/content";

interface Props {
  lang: Lang;
  /** Combien de signaux montrer. 3 à 5, jamais plus — au-delà, ce n'est plus un signal, c'est une liste. */
  limit?: number;
}

const { lang, limit = 5 } = Astro.props;
const t = useTranslations(lang);

/**
 * WEBLACK NOW — radar culturel curaté.
 *
 * Deux flux, une seule bande. Les événements Agenda actuellement ONGOING
 * (déjà vérifiés par ce pipeline, déjà en ligne comme documents `event` —
 * getOngoingEvents lit exactement ce que la page d'accueil affichait avant
 * ce chantier). Et, depuis ce chantier, des signaux éditoriaux — une
 * nomination, une collaboration, une collection, une distinction — issus du
 * même degré d'exigence que le Journal (Evidence Pack, anti-fabrication,
 * Quality Gate à huit conditions) mais réduits à une phrase, jamais un
 * article : voir editorial-engine/now/.
 *
 * getNowSignals() ne renvoie rien tant que le schéma `nowSignal` n'est pas
 * déployé dans Sanity et qu'aucun cycle n'a été exécuté (npm run
 * editorial:now -- run) — la bande continue alors de fonctionner
 * exactement comme avant ce chantier, sur les seuls événements Agenda.
 * Rien n'est fabriqué pour remplir l'écart.
 *
 * Trois fonctions voisines restent distinctes : le Journal dit ce que
 * WEBLACK pense, l'Agenda ce qui vient, ce bloc ce qui bouge maintenant —
 * vérifié, jamais un flux brut, jamais un second Agenda.
 *
 * Le bloc ne défile pas (une bande de marque glisse déjà sous le hero —
 * une seconde en mouvement produirait une répétition visuelle là où il
 * fallait une différence de nature) et ne porte pas de lien « Tout
 * l'agenda » (doublon exact du lien qu'Agenda porte déjà, juste en
 * dessous dans l'architecture de l'accueil).
 */
const [ongoing, signals] = await Promise.all([getOngoingEvents(lang), getNowSignals(lang)]);

const sortedOngoing = ongoing.sort(
  (a, b) => (b.editorialRelevance ?? 0) - (a.editorialRelevance ?? 0) || b.startDate.localeCompare(a.startDate),
);

interface NowItem {
  key: string;
  label: string;
  title: string;
  href: string;
}

/**
 * Une ville par événement Agenda, tant qu'il y a des villes — sans cette
 * règle, une même ville riche en expositions saturait la bande et
 * masquait les autres scènes. Les signaux éditoriaux n'ont pas de ville :
 * ils portent un territoire, déjà distinct par construction (dédoublonnés
 * en amont par editorial-engine/now/dedupe.ts).
 */
const villes = new Set<string>();
const items: NowItem[] = [];

for (const event of sortedOngoing) {
  if (items.length >= limit) break;
  if (villes.has(event.city)) continue;
  villes.add(event.city);
  items.push({
    key: `event-${event.id}`,
    label: event.discipline ? `${event.city} · ${event.discipline}` : event.city,
    title: event.eventName,
    href: event.officialUrl,
  });
}
for (const signal of signals) {
  if (items.length >= limit) break;
  items.push({
    key: `signal-${signal.id}`,
    label: t(`now.territory.${signal.territory}` as UiKey) || signal.territory,
    title: signal.title,
    href: signal.sourceUrl,
  });
}
// Complète jusqu'à la limite en reprenant l'agenda (villes déjà vues
// incluses) plutôt que de laisser la bande sous son minimum de trois — la
// diversité de villes est une préférence, pas une règle qui viderait le bloc.
if (items.length < limit) {
  for (const event of sortedOngoing) {
    if (items.length >= limit) break;
    const key = `event-${event.id}`;
    if (items.some((i) => i.key === key)) continue;
    items.push({
      key,
      label: event.discipline ? `${event.city} · ${event.discipline}` : event.city,
      title: event.eventName,
      href: event.officialUrl,
    });
  }
}
---

{
  items.length > 0 && (
    <section class="bg-(--color-ink) px-6 md:px-10" aria-labelledby="weblack-now">
      <div class="mx-auto max-w-(--container-content) border-y border-(--color-line) py-8">
        <div>
          <h2 id="weblack-now" class="label-tracked flex items-center gap-2.5 text-(--color-gold)">
            <span class="now-dot" aria-hidden="true" />
            {t("now.label")}
          </h2>
          <p class="mt-1.5 max-w-md text-sm text-(--color-paper)/50">{t("now.description")}</p>
        </div>

        {/*
          1 → 5 colonnes directement : entre 3 et 5 signaux (NOW_POLICY),
          jamais plus, jamais moins — une seule ligne possible à lg:, donc
          aucun signal ne peut jamais se retrouver seul sur une ligne vide.
          Un palier intermédiaire à 2 colonnes créait exactement ce
          déséquilibre entre 640 et 1023px pour 5 signaux.
        */}
        <ul class="m-0 mt-6 grid list-none grid-cols-1 gap-x-10 gap-y-5 p-0 lg:grid-cols-5">
          {items.map((item) => (
            <li class="min-w-0">
              <a href={item.href} target="_blank" rel="noopener noreferrer" class="group block">
                <p class="label-tracked text-(--color-paper)/40">{item.label}</p>
                <p class="font-display mt-2 text-lg text-(--color-paper) transition-colors group-hover:text-(--color-gold)">
                  {item.title}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  /*
    Un point qui respire — le seul mouvement du bloc, et il porte le sens :
    ces événements sont ouverts à l'instant où la page est lue. Il s'arrête
    si le visiteur refuse les animations ; l'information, elle, ne dépend
    jamais du mouvement. Pas de ticker : le mouvement reste lent, discret,
    et n'affecte jamais la lecture du contenu lui-même.
  */
  .now-dot {
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 9999px;
    background: var(--color-gold);
  }

  @media (prefers-reduced-motion: no-preference) {
    .now-dot {
      animation: now-pulse 2.4s ease-in-out infinite;
    }
  }

  @keyframes now-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.35;
      transform: scale(0.8);
    }
  }
</style>
