---
import { useTranslations, localizedPath, type Lang, type UiKey } from "../../i18n/utils";
import type { ExpertiseData, HomepageTextSection } from "../../lib/content";

interface Props {
  lang: Lang;
  /** From the `expertise` Sanity type — falls back to i18n copy below when empty. */
  expertises?: ExpertiseData[];
  /** From the "homepage" Sanity singleton's expertisesSection — falls back to i18n copy when not set. */
  section?: HomepageTextSection;
}

const { lang, expertises, section } = Astro.props;
const t = useTranslations(lang);

const fallbackDivisions = [
  { key: "talent", href: "/talent" },
  { key: "creative", href: "/creative" },
  { key: "consulting", href: "/consulting" },
] as const;

const divisions =
  expertises && expertises.length > 0
    ? expertises.map((e) => ({
        name: e.title,
        tagline: e.tagline ?? "",
        href: `/${e.slug}`,
      }))
    : fallbackDivisions.map((d) => ({
        name: t(`division.${d.key}.name` as UiKey),
        tagline: t(`division.${d.key}.tagline` as UiKey),
        href: d.href,
      }));

const eyebrow = t("home.divisions.eyebrow");
const title = section?.title ?? t("home.divisions.title");
---

<section class="bg-(--color-ink) py-24 md:py-32">
  <div class="mx-auto max-w-(--container-content) px-6 md:px-10">
    <div class="max-w-2xl" data-reveal>
      <p class="label-tracked label-tracked-dot text-(--color-gold)">{eyebrow}</p>
      <h2 class="font-display mt-4 text-4xl text-(--color-paper) sm:text-5xl">
        {title}
      </h2>
    </div>

    <div class="mt-16 grid grid-cols-1 border-t border-(--color-line) md:grid-cols-3">
      {
        divisions.map((division, i) => (
          <a
            href={localizedPath(lang, division.href)}
            class="group flex flex-col justify-between border-b border-(--color-line) px-1 py-10 transition-colors duration-300 md:border-b-0 md:border-r md:px-8 md:last:border-r-0"
            data-reveal
            data-reveal-delay={String(i * 0.1)}
          >
            <div>
              <span class="label-tracked text-(--color-paper)/40">0{i + 1}</span>
              <h3 class="font-display mt-6 text-3xl text-(--color-paper) transition-colors duration-300 group-hover:text-(--color-gold)">
                {division.name}
              </h3>
              <p class="mt-4 max-w-xs text-(--color-paper)/60">{division.tagline}</p>
            </div>
            <span class="label-tracked mt-10 inline-flex items-center gap-2 text-(--color-paper)/50 transition-colors duration-300 group-hover:text-(--color-gold)">
              {t("common.discover")} {division.name} &rarr;
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
