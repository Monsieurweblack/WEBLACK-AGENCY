---
import RemoteImage from "../media/RemoteImage.astro";
import { localizedPath, useTranslations, type Lang } from "../../i18n/utils";
import type { WorkEntry } from "../../lib/content";

interface Props {
  lang: Lang;
  work: WorkEntry;
  index?: number;
}

const { lang, work, index = 0 } = Astro.props;
const t = useTranslations(lang);
const href = localizedPath(lang, `/selected-work/${work.data.slug}`);
---

<a href={href} class="group block" data-reveal data-reveal-delay={String((index % 3) * 0.08)}>
  <div class="relative aspect-[4/5] overflow-hidden bg-(--color-ink-soft)">
    <RemoteImage
      src={work.data.coverImage.url}
      alt={work.data.coverImage.alt}
      width={800}
      height={1000}
      credit={work.data.coverImage.credit}
      class="h-full w-full opacity-90 transition-transform duration-700 ease-(--ease-signature) group-hover:scale-105"
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-(--color-ink) via-(--color-ink)/10 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 p-6">
      <p class="label-tracked text-(--color-gold)">{work.data.client} · {work.data.year}</p>
      <h3 class="font-display mt-2 text-2xl text-(--color-paper) transition-colors group-hover:text-(--color-gold)">
        {work.data.title}
      </h3>
      <p class="mt-2 text-sm text-(--color-paper)/60">{work.data.disciplines.join(" · ")}</p>
      <p
        class="label-tracked mt-3 translate-y-1 text-(--color-gold) opacity-0 transition-[opacity,transform] duration-500 ease-(--ease-signature) group-hover:translate-y-0 group-hover:opacity-100"
      >
        {t("common.readMore")} &rarr;
      </p>
    </div>
  </div>
</a>
