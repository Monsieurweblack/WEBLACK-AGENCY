---
import { otherLang, switchLocalePath, useTranslations, type Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
  class?: string;
  /**
   * Overrides the naive same-slug path swap below — needed wherever the
   * current page has no guaranteed counterpart at the same slug in the
   * other language (e.g. a Journal article only published in one
   * language). Without this, the switcher can link straight to a 404.
   */
  hrefOverride?: string;
}

const { lang, class: className, hrefOverride } = Astro.props;
const t = useTranslations(lang);
const target = otherLang(lang);
const href = hrefOverride ?? switchLocalePath(Astro.url.pathname, target);
const label = target === "fr" ? "FR" : "EN";
const switchLabel = target === "fr" ? t("common.switchToFr") : t("common.switchToEn");
---

<a
  href={href}
  class:list={[
    "label-tracked items-center gap-2 border border-(--color-line) px-3 py-2 text-(--color-paper) transition-colors duration-300 hover:border-(--color-gold) hover:text-(--color-gold)",
    className,
  ]}
  aria-label={switchLabel}
>
  {label}
</a>
