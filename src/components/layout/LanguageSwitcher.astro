---
import { otherLang, switchLocalePath, type Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const target = otherLang(lang);
const href = switchLocalePath(Astro.url.pathname, target);
const label = target === "fr" ? "FR" : "EN";
---

<a
  href={href}
  class:list={[
    "label-tracked inline-flex items-center gap-2 border border-(--color-line) px-3 py-2 text-(--color-paper) transition-colors duration-300 hover:border-(--color-gold) hover:text-(--color-gold)",
    className,
  ]}
  aria-label={`Switch to ${target === "fr" ? "français" : "English"}`}
>
  {label}
</a>
