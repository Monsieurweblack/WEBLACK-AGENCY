---
import type { Lang } from "../../i18n/utils";
import { malyaCopy } from "../../lib/malya-copy";
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = malyaCopy(lang);
---
<button type="button" id="malya-launcher" data-lang={lang} aria-haspopup="dialog" aria-label={c.launcher}
  class="fixed bottom-4 right-4 z-40 inline-flex min-h-12 min-w-12 items-center justify-center gap-2 rounded-full border border-(--color-gold) bg-(--color-ink) px-4 text-(--color-gold) transition-colors hover:bg-(--color-gold) hover:text-(--color-ink) sm:bottom-6 sm:right-6">
  <span class="font-display text-lg leading-none" aria-hidden="true">M</span>
  <span class="label-tracked hidden sm:inline" aria-hidden="true">MALYA</span>
</button>
<script>
  import "../../scripts/malya-launcher";
</script>
