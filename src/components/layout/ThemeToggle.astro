---
import { useTranslations, type Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = useTranslations(lang);
---

<button
  type="button"
  data-theme-toggle
  class:list={[
    "min-h-11 min-w-11 items-center justify-center border border-(--color-line) p-2 text-(--color-paper) transition-colors duration-300 hover:border-(--color-gold) hover:text-(--color-gold)",
    className,
  ]}
  data-label-to-light={t("theme.toggle.toLight")}
  data-label-to-dark={t("theme.toggle.toDark")}
  aria-pressed="false"
>
  <svg
    data-icon-sun
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    width="18"
    height="18"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <svg
    data-icon-moon
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    width="18"
    height="18"
    aria-hidden="true"
    style="display:none"
  >
    <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"></path>
  </svg>
</button>
