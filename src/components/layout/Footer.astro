---
import { Image } from "astro:assets";
import weblackIcon from "../../assets/logo/weblack-icon-gold-180.png";
import SocialLinks from "./SocialLinks.astro";
import NewsletterForm from "../forms/NewsletterForm.astro";
import ShareButtons from "./ShareButtons.astro";
import { useTranslations, localizedPath, type Lang } from "../../i18n/utils";
import type { SiteSettingsData } from "../../lib/content";

interface Props {
  lang: Lang;
  /** From the "siteSettings" Sanity singleton — falls back to i18n copy below when a field isn't set. */
  siteSettings?: SiteSettingsData;
}

const { lang, siteSettings } = Astro.props;
const t = useTranslations(lang);
const tagline = siteSettings?.baseline ?? t("footer.tagline");
const sinceText = siteSettings?.footerText ?? t("footer.since");
const year = new Date().getFullYear();
const currentUrl = new URL(Astro.url.pathname, Astro.site).toString();

/**
 * Quatre colonnes de liens, et pourquoi elles changent de contenu.
 *
 * La colonne « Agence » rassemblait six liens de trois natures : ce que
 * l'agence est (À propos, Engagements, Partenaires) et ce qu'elle publie
 * (Journal, Agenda, Opportunities). La colonne « Informations légales »,
 * elle, hébergeait Contact — qui n'a rien de légal — à côté des mentions.
 * Un visiteur cherchant à joindre l'agence n'avait aucune raison de
 * regarder sous « Informations légales », et un moteur qui déduit la
 * structure d'un site de ses blocs de liens y lisait trois sujets mêlés.
 *
 * Désormais : les divisions (ce qu'on fait), les publications (ce qu'on
 * édite, datées, avec le flux), la maison (qui l'on est et comment nous
 * joindre), le légal (rien d'autre que le légal).
 *
 * Opportunities prend son libellé traduit : il était écrit en dur en
 * anglais, donc identique sur la version française.
 */
const divisionLinks = [
  { label: t("nav.talent"), href: "/talent" },
  { label: t("nav.creative"), href: "/creative" },
  { label: t("nav.consulting"), href: "/consulting" },
  { label: t("nav.selectedwork"), href: "/selected-work" },
];

const publicationLinks = [
  { label: t("nav.journal"), href: "/journal" },
  { label: t("nav.agenda"), href: "/agenda" },
  { label: t("nav.opportunities"), href: "/opportunities" },
];

const houseLinks = [
  { label: t("nav.about"), href: "/about" },
  { label: t("nav.responsibility"), href: "/responsibility" },
  { label: t("nav.partners"), href: "/partners" },
  { label: t("nav.contact"), href: "/contact" },
];

const legalLinks = [
  { label: t("footer.mentions"), href: "/mentions-legales" },
  { label: t("footer.privacy"), href: "/politique-de-confidentialite" },
  // Page d'accueil de l'application déclarée dans Google Auth Platform : atteignable depuis toutes les pages.
  { label: t("footer.talentPlatform"), href: "/talent/plateforme" },
];

// Le flux de la langue de la page — jamais l'autre.
const rssHref = lang === "fr" ? "/journal/rss.xml" : "/en/journal/rss.xml";
---

<footer class="border-t border-(--color-line) bg-(--color-ink) text-(--color-paper)">
  <div class="mx-auto max-w-(--container-content) px-6 py-16 md:px-10 md:py-20">
    <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-[1.3fr_repeat(4,minmax(0,1fr))]">
      <div>
        <div class="flex items-center gap-3">
          <Image src={weblackIcon} alt="WEBLACK" width={36} height={36} />
          <p class="font-display text-2xl tracking-[0.05em]">WEBLACK</p>
        </div>
        <p class="label-tracked mt-4 text-(--color-paper)/60">{tagline}</p>
        <p class="mt-6 max-w-xs text-sm text-(--color-paper)/50">{sinceText}</p>

        {/*
          L'inscription vit dans la première colonne, sous la signature :
          c'est la place qu'occupe déjà ce que la marque dit d'elle-même, et
          elle laisse les trois colonnes de liens intactes. Le pied de page
          étant sur chaque page, l'inscription l'est aussi — sans qu'aucune
          page n'ait à lui céder de la surface.
        */}
        <div class="mt-10 max-w-sm">
          <p class="label-tracked text-(--color-gold)">{t("newsletter.title")}</p>
          <p class="mt-3 text-sm text-(--color-paper)/60">{t("newsletter.intro")}</p>
          <NewsletterForm lang={lang} />
        </div>
      </div>

      <nav aria-label={t("footer.explore")}>
        <p class="label-tracked text-(--color-gold)">{t("footer.explore")}</p>
        <ul class="mt-4 space-y-3">
          {
            divisionLinks.map((link) => (
              <li>
                <a
                  href={localizedPath(lang, link.href)}
                  class="text-sm text-(--color-paper)/70 transition-colors hover:text-(--color-paper)"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label={t("footer.publications")}>
        <p class="label-tracked text-(--color-gold)">{t("footer.publications")}</p>
        <ul class="mt-4 space-y-3">
          {
            publicationLinks.map((link) => (
              <li>
                <a
                  href={localizedPath(lang, link.href)}
                  class="text-sm text-(--color-paper)/70 transition-colors hover:text-(--color-paper)"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            {/* Le flux existe : un lecteur doit pouvoir le trouver sans lire le code source de la page. */}
            <a
              href={rssHref}
              class="text-sm text-(--color-paper)/70 transition-colors hover:text-(--color-paper)"
            >
              {t("footer.rss")}
            </a>
          </li>
        </ul>
      </nav>

      <nav aria-label={t("footer.studio")}>
        <p class="label-tracked text-(--color-gold)">{t("footer.studio")}</p>
        <ul class="mt-4 space-y-3">
          {
            houseLinks.map((link) => (
              <li>
                <a
                  href={localizedPath(lang, link.href)}
                  class="text-sm text-(--color-paper)/70 transition-colors hover:text-(--color-paper)"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label={t("footer.legal")}>
        <p class="label-tracked text-(--color-gold)">{t("footer.legal")}</p>
        <ul class="mt-4 space-y-3">
          {
            legalLinks.map((link) => (
              <li>
                <a
                  href={localizedPath(lang, link.href)}
                  class="text-sm text-(--color-paper)/70 transition-colors hover:text-(--color-paper)"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <button
              type="button"
              data-open-consent-preferences
              class="text-sm text-(--color-paper)/70 transition-colors hover:text-(--color-paper)"
            >
              {t("footer.privacyPreferences")}
            </button>
          </li>
        </ul>
      </nav>
    </div>

    <div
      class="mt-16 flex flex-col gap-6 border-t border-(--color-line) pt-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="flex flex-col gap-2 text-xs text-(--color-paper)/50">
        <p>&copy; {year} WEBLACK. {t("footer.rights")}</p>
        <p>{t("contact.info.address.label")}</p>
      </div>
      <SocialLinks siteSettings={siteSettings} />
    </div>

    <div class="mt-8 border-t border-(--color-line) pt-8">
      <ShareButtons lang={lang} url={currentUrl} title={t("seo.default.title")} label={t("share.site")} />
    </div>
  </div>
</footer>
