---
import { useTranslations, resolveTranslations, type Lang, type TranslationMap } from "../../i18n/utils";
import { LOCALES, defaultLocale, ogLocaleFor } from "../../i18n/locales";
import { SOCIAL_LINKS } from "../../lib/social";
import type { SiteSettingsData } from "../../lib/content";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  /** From the "siteSettings" Sanity singleton — used only as the fallback source for title/description/OG image when the page doesn't supply its own. Falls back to i18n copy when unavailable. */
  siteSettings?: SiteSettingsData;
  /**
   * Per-locale map of this exact content's URL in each other locale —
   * supplied by the calling route only when the naive same-slug swap
   * doesn't resolve (e.g. a Journal article published in only one
   * language, or with different FR/EN slugs). When omitted, every enabled
   * locale is assumed reachable via the same-slug swap (correct for static
   * pages and most content). A locale missing from this map — or the whole
   * map resolving to zero entries — means hreflang must not claim a
   * translation for it: never point crawlers at a URL that doesn't exist.
   * See src/i18n/utils.ts `resolveTranslations`.
   */
  translations?: TranslationMap;
}

const { lang, title, description, image, imageAlt, noindex = false, translations, siteSettings } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ? `${title} — WEBLACK` : (siteSettings?.seoTitle ?? t("seo.default.title"));
const pageDescription = description ?? siteSettings?.seoDescription ?? t("seo.default.description");
const DEFAULT_OG_IMAGE = lang === "fr" ? "/photos/og-weblack-fr.jpg" : "/photos/og-weblack-en.jpg";
const ogImage = new URL(image ?? siteSettings?.ogImage?.url ?? DEFAULT_OG_IMAGE, Astro.site);
const isDefaultOgImage = !image;
const ogImageWidth = image ? 1200 : (siteSettings?.ogImage?.width ?? 1200);
const ogImageHeight = image ? 630 : (siteSettings?.ogImage?.height ?? 630);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const logoUrl = new URL("/apple-touch-icon.png", Astro.site);
const homeUrl = new URL(lang === defaultLocale ? "/" : `/${lang}/`, Astro.site).toString();

const ogLocale = ogLocaleFor(lang);
const schemaLang = LOCALES[lang].hreflang;

// Resolved alternate-locale entries for this exact page. Empty when no
// translation is known anywhere — the whole hreflang block is then omitted
// (see the E-2/D-1 fix this preserves) rather than pointing at a guess.
const alternates = resolveTranslations(lang, Astro.url.pathname, translations);
const hasAlternates = alternates.length > 0;

function hrefFor(targetLang: Lang): string {
  if (targetLang === lang) return canonicalUrl.toString();
  const found = alternates.find((entry) => entry.lang === targetLang);
  return found ? new URL(found.path, Astro.site).toString() : "";
}

const xDefaultHref = hasAlternates ? hrefFor(defaultLocale) || canonicalUrl.toString() : "";

const sameAs = [
  siteSettings?.facebookUrl ?? SOCIAL_LINKS.facebook,
  siteSettings?.instagramUrl ?? SOCIAL_LINKS.instagram,
  siteSettings?.linkedinUrl,
  siteSettings?.youtubeUrl,
].filter((url): url is string => Boolean(url));

/**
 * Graphe de connaissances du site.
 *
 * Deux objets plats coexistaient ici, sans lien entre eux : un moteur — ou
 * un modèle de langage qui cite des sources — n'en tirait qu'un nom et une
 * URL. Un `@graph` avec des `@id` dit autre chose : que ce site est publié
 * par cette organisation, qu'elle a été fondée par cette personne, qu'elle
 * opère dans ces régions et exerce ces trois métiers. C'est ce maillage qui
 * se cite, pas une fiche isolée.
 *
 * Ce qui n'y figure pas est volontaire. Aucune adresse postale, aucun
 * téléphone, aucun effectif, aucune distinction : rien de tout cela n'est
 * vérifié, et la discipline de non-fabrication du projet vaut autant pour
 * les données structurées que pour le texte visible — sans doute davantage,
 * puisque personne ne les relit.
 */
const ORG_ID = `${homeUrl}#organization`;
const FOUNDER_ID = `${homeUrl}#founder`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": ORG_ID,
      name: siteSettings?.siteName ?? "WEBLACK",
      url: homeUrl,
      logo: logoUrl,
      image: ogImage.toString(),
      description: siteSettings?.seoDescription ?? t("seo.default.description"),
      // Fondée en 2010 — le seul repère temporel que le projet établisse.
      foundingDate: "2010",
      founder: { "@id": FOUNDER_ID },
      sameAs,
      inLanguage: schemaLang,
      // L'aire d'activité, dans le sens du positionnement : une vision
      // africaine et afro-descendante portée à l'international — de
      // l'Afrique vers le monde. Le continent est nommé comme origine du
      // regard, « Worldwide » comme portée réelle ; l'agence ne se limite
      // à aucun marché.
      areaServed: [
        { "@type": "Continent", name: lang === "en" ? "Africa" : "Afrique" },
        { "@type": "Place", name: "Worldwide" },
      ],
      // `knowsAbout` est ce sur quoi un moteur génératif s'appuie pour citer
      // une organisation à propos d'un sujet. La perspective culturelle y a
      // donc sa place au même titre que les métiers — et les termes suivent
      // la langue de la page : une liste française sur la version anglaise
      // ne serait rapprochée d'aucune question posée en anglais.
      knowsAbout:
        lang === "en"
          ? [
              "Art direction",
              "Talent management",
              "Brand strategy",
              "Fashion",
              "Content production",
              "Cultural intelligence",
              "African and Afro-descendant creation",
              "African creative industries",
            ]
          : [
              "Direction artistique",
              "Management de talents",
              "Stratégie de marque",
              "Mode",
              "Production de contenu",
              "Intelligence culturelle",
              "Création africaine et afro-descendante",
              "Industries créatives africaines",
            ],
      // Les trois divisions, telles qu'elles existent dans la navigation du
      // site — pas une liste d'offres inventée pour le balisage.
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: siteSettings?.siteName ?? "WEBLACK",
        itemListElement: [
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Talent", url: `${homeUrl}talent` } },
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Creative", url: `${homeUrl}creative` } },
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Consulting", url: `${homeUrl}consulting` } },
        ],
      },
    },
    {
      "@type": "Person",
      "@id": FOUNDER_ID,
      name: "Deo-Gratias Kpodo",
      jobTitle: "Founder & Creative Director",
      worksFor: { "@id": ORG_ID },
    },
    {
      "@type": "WebSite",
      "@id": `${homeUrl}#website`,
      name: siteSettings?.siteName ?? "WEBLACK",
      url: homeUrl,
      publisher: { "@id": ORG_ID },
      inLanguage: schemaLang,
    },
    {
      "@type": "WebPage",
      "@id": canonicalUrl.toString(),
      url: canonicalUrl.toString(),
      name: pageTitle,
      description: pageDescription,
      isPartOf: { "@id": `${homeUrl}#website` },
      inLanguage: schemaLang,
    },
  ],
};
---

<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<link rel="canonical" href={canonicalUrl} />
{
  !noindex && hasAlternates && (
    <link rel="alternate" hreflang={LOCALES[lang].hreflang} href={canonicalUrl.toString()} />
  )
}
{
  !noindex &&
    alternates.map((entry) => (
      <link
        rel="alternate"
        hreflang={LOCALES[entry.lang].hreflang}
        href={new URL(entry.path, Astro.site).toString()}
      />
    ))
}
{
  !noindex && hasAlternates && (
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
  )
}
{noindex && <meta name="robots" content="noindex,nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:image" content={ogImage} />
{isDefaultOgImage && <meta property="og:image:width" content={String(ogImageWidth)} />}
{isDefaultOgImage && <meta property="og:image:height" content={String(ogImageHeight)} />}
<meta property="og:image:alt" content={imageAlt ?? t("seo.ogImage.alt")} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content={ogLocale} />
{alternates.map((entry) => <meta property="og:locale:alternate" content={ogLocaleFor(entry.lang)} />)}
<meta property="og:site_name" content={siteSettings?.siteName ?? "WEBLACK"} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt ?? t("seo.ogImage.alt")} />

{
  !noindex && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
    />
  )
}
