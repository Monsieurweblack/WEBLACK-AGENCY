---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { useTranslations, languages, type Lang } from "../../i18n/utils";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { lang, title, description, image, noindex = false } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ? `${title} — WEBLACK` : t("seo.default.title");
const pageDescription = description ?? t("seo.default.description");
const DEFAULT_OG_IMAGE = "/photos/banner-model-logo-bw-2400.jpg";
const ogImage = new URL(image ?? DEFAULT_OG_IMAGE, Astro.site);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const pathWithoutLang = Astro.url.pathname.replace(/^\/(fr|en)(?=\/|$)/, "") || "/";
---

<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<link rel="canonical" href={canonicalUrl} />
{
  !noindex &&
    (Object.keys(languages) as Lang[]).map((locale) => (
      <link
        rel="alternate"
        hreflang={locale}
        href={getAbsoluteLocaleUrl(locale, pathWithoutLang)}
      />
    ))
}
{
  !noindex && (
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl("fr", pathWithoutLang)} />
  )
}
{noindex && <meta name="robots" content="noindex,nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:image" content={ogImage} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_US"} />
<meta property="og:site_name" content="WEBLACK" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={ogImage} />
