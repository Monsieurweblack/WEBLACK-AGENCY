---
import { Image } from "astro:assets";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import WorkWithPicker from "./WorkWithPicker.astro";
import ThemeToggle from "./ThemeToggle.astro";
import SocialLinks from "./SocialLinks.astro";
import SearchOverlay from "./SearchOverlay.astro";
import weblackIcon from "../../assets/logo/weblack-icon-gold-180.png";
import { useTranslations, localizedPath, type Lang, type TranslationMap } from "../../i18n/utils";
import { getLiveEvents, getPrimaryLive, type SiteSettingsData } from "../../lib/content";

interface Props {
  lang: Lang;
  translations?: TranslationMap;
  siteSettings?: SiteSettingsData;
}

const { lang, translations, siteSettings } = Astro.props;
const t = useTranslations(lang);
const isOnAir = getPrimaryLive(await getLiveEvents(lang))?.status === "live";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const navItems = [
  { label: t("nav.talent"), href: "/talent" },
  { label: t("nav.creative"), href: "/creative" },
  { label: t("nav.consulting"), href: "/consulting" },
  { label: t("nav.selectedwork"), href: "/selected-work" },
  { label: t("nav.journal"), href: "/journal" },
  { label: t("nav.agenda"), href: "/agenda" },
  { label: t("nav.responsibility"), href: "/responsibility" },
  { label: t("nav.about"), href: "/about" },
].map((item) => {
  const href = localizedPath(lang, item.href);
  return { ...item, href, isActive: href.replace(/\/$/, "") === currentPath };
});

const homeHref = localizedPath(lang, "/");
const contactHref = localizedPath(lang, "/contact");
const liveHref = localizedPath(lang, "/live");
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-[76] transition-colors duration-500"
  data-header
>
  <div
    class="site-header-row mx-auto flex max-w-(--container-content) items-center justify-between gap-4 px-6 pb-5 md:px-10"
  >
    <a
      href={homeHref}
      class="flex items-center gap-3 transition-opacity hover:opacity-80"
    >
      <span class="relative inline-flex h-[34px] w-[34px] shrink-0 items-center justify-center">
        <span class="logo-ring pointer-events-none absolute -inset-1 rounded-full" aria-hidden="true"></span>
        <Image src={weblackIcon} alt="WEBLACK" width={34} height={34} loading="eager" class="relative" />
      </span>
      <span class="font-display text-lg tracking-[0.05em] text-(--color-paper)">WEBLACK</span>
    </a>

    <div class="header-cluster flex items-center gap-3">
      <a
        href={liveHref}
        class:list={[
          "label-tracked inline-flex items-center transition-[color,transform] duration-300 hover:-translate-y-px",
          isOnAir ? "gap-2 live-on-air" : "text-(--color-paper) hover:text-(--color-gold)",
        ]}
      >
        {isOnAir && <span class="live-on-air-dot" aria-hidden="true" />}
        {t("nav.live")}
      </a>
      <WorkWithPicker lang={lang} />
      <LanguageSwitcher lang={lang} translations={translations} />
      <button
        type="button"
        id="menu-trigger"
        class="label-tracked inline-flex min-h-11 items-center gap-2 border border-(--color-line) px-3.5 py-1.5 text-(--color-paper) transition-colors duration-300 hover:border-(--color-gold) hover:text-(--color-gold)"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="site-menu"
        data-close-label={t("nav.close")}
      >
        <span data-menu-label>{t("nav.menu")}</span>
        <span class="relative block h-2.5 w-4" aria-hidden="true">
          <span
            class="absolute left-0 top-0 block h-px w-4 bg-current transition-transform duration-300"
            data-menu-bar-top></span>
          <span
            class="absolute bottom-0 left-0 block h-px w-4 bg-current transition-transform duration-300"
            data-menu-bar-bottom></span>
        </span>
      </button>
    </div>
  </div>
  <noscript>
    <nav
      class="border-t border-(--color-line) bg-(--color-ink) px-6 py-4 md:px-10"
      aria-label={t("nav.ariaLabel")}
    >
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="label-tracked text-(--color-paper)"
                aria-current={item.isActive ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={contactHref} class="label-tracked text-(--color-gold)">
            {t("nav.contact")}
          </a>
        </li>
      </ul>
    </nav>
  </noscript>
</header>

<div
  id="site-menu"
  class="menu-overlay fixed inset-0 z-[75] flex flex-col bg-(--color-ink) opacity-0 pointer-events-none"
  data-menu-panel
  aria-hidden="true"
  inert
>
  <div class="menu-content flex min-h-0 flex-1 flex-col overflow-y-auto">
    <div class="menu-spacer-top shrink" aria-hidden="true"></div>
    <nav
      class="menu-nav mx-auto flex w-full shrink-0 max-w-(--container-content) flex-col px-6 md:px-10"
      aria-label={t("nav.ariaLabel")}
    >
      {
        navItems.map((item, i) => (
          <a
            href={item.href}
            class="menu-link translate-y-4 font-display text-(--color-paper) opacity-0 transition-colors duration-300 hover:text-(--color-gold)"
            style={`transition-delay:${i * 40}ms`}
            aria-current={item.isActive ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="menu-spacer-bottom shrink" aria-hidden="true"></div>
  </div>
  <div
    class="menu-footer mx-auto flex w-full max-w-(--container-content) shrink-0 flex-wrap items-center justify-between gap-x-6 gap-y-4 border-t border-(--color-line) px-6 py-5 md:px-10"
  >
    <a
      href={contactHref}
      class="label-tracked text-(--color-paper) transition-colors hover:text-(--color-gold)"
    >
      {t("nav.contact")}
    </a>
    <div class="flex items-center gap-4">
      <SocialLinks siteSettings={siteSettings} />
      <SearchOverlay lang={lang} class="inline-flex" />
      <ThemeToggle lang={lang} class="inline-flex" />
    </div>
  </div>
</div>

<style>
  /*
   * Centralized here (rather than as stacked Tailwind text-[…]/lg:/3xl:
   * utilities) because Tailwind v4 orders a custom breakpoint's generated
   * CSS by registration order, not by the pixel value in --breakpoint-3xl
   * (global.css) — at 1920px both the lg: (1024px) and 3xl: (1920px) media
   * queries match simultaneously, and lg: happened to be emitted *after*
   * 3xl: in the bundle, so it silently won every time. A single, explicitly
   * mobile-first block removes that ambiguity and is also the one place to
   * tune the whole scale. Four tiers, one per requested screen class
   * (mobile / tablet / desktop / very large) — deliberately not a naive
   * uniform cut of the previous text-4xl/6xl/7xl scale: each step is tuned
   * so the menu stays large and editorial without dominating the viewport,
   * with denser leading and tighter vertical gaps at every tier.
   */
  /*
   * Inert today (the viewport meta has no viewport-fit=cover, so the
   * browser already keeps fixed content clear of a notch/dynamic island on
   * its own and env() resolves to 0) — kept ready rather than added later
   * as an afterthought, at zero cost while inactive.
   */

  /*
   * Ordre d'empilement, et pourquoi ces valeurs précises.
   *
   * Le bandeau de consentement est en z-[70] et couvrait le bas du menu :
   * en paysage, la dernière entrée disparaissait derrière lui. Le menu est
   * une navigation modale — tant qu'il est ouvert, il doit passer devant
   * tout ce qui est décoratif ou informatif.
   *
   *   80  fenêtre de préférences (reste au-dessus de tout : c'est un choix
   *       que le visiteur doit pouvoir faire sans obstacle)
   *   78  fenêtre d'inscription à la lettre
   *   77  sélecteur de profil du header (WorkWithPicker) — au-dessus de
   *       l'en-tête qui le porte, jamais devant une fenêtre modale
   *   76  en-tête      (le bouton FERMER doit rester atteignable)
   *   75  menu
   *   70  bandeau de consentement
   */
  .site-header-row {
    padding-top: calc(1.25rem + env(safe-area-inset-top, 0px));
  }

  /*
   * Quatre commandes persistantes (Live, le sélecteur de profil, la langue,
   * le menu) plus le logo ne tiennent pas sur une ligne en dessous du
   * palier md: (768px) — y compris entre 640 et 767px, où le sélecteur de
   * profil affiche déjà son texte complet (son propre seuil sm: à 640px) :
   * mesuré, "Menu" y sortait du cadre à droite, ou son bouton se
   * compressait au point de faire passer son propre texte à la ligne.
   * Plutôt que de réduire chaque bouton sous une taille tactile confortable
   * pour gagner quelques pixels, le groupe bascule sur sa propre ligne,
   * aligné à droite sous le logo — chaque commande garde sa taille
   * normale, et le ResizeObserver de nav.ts absorbe automatiquement la
   * hauteur d'en-tête supplémentaire dans le calcul du menu.
   */
  @media (max-width: 767px) {
    .site-header-row {
      flex-wrap: wrap;
      row-gap: 0.625rem;
    }

    .header-cluster {
      flex: 1 1 100%;
      justify-content: flex-end;
    }
  }

  /*
   * --header-h is measured live off the real header (see nav.ts) rather
   * than guessed as a fixed padding value — a hardcoded guess is exactly
   * what let the first item render partly behind the header whenever the
   * real header's rendered height didn't match the guess (different font
   * metrics while webfonts are still loading, a wrapped Live label, etc).
   * The fallback here only matters for the instant before that first
   * measurement lands, which happens synchronously on init, before the
   * menu can possibly be opened.
   *
   * The nav sits between two spacers rather than being centered or
   * top-locked. The top one is a *fixed* size (header clearance plus a
   * breathing amount that itself scales with svh, so a tall screen gets
   * more top margin than a short one) — not a flex-grow share, because a
   * grow ratio here loses the fight to the min-height floor the instant
   * that floor exceeds the ratio's natural share (which it does on most
   * phone heights), collapsing back to "everything ends up below." The
   * bottom spacer absorbs whatever's actually left via flex-grow. Net
   * effect: the group reads as "slightly toward the top" — proportionally
   * more so on tall screens — never mathematically centered (explicitly
   * ruled out) and never a tiny island stranded in one huge bottom void.
   * On short viewports the bottom spacer shrinks to its floor and
   * .menu-content's own scroll takes over — no item is ever pushed
   * off-screen to make this "work."
   */
  .menu-spacer-top {
    flex: 0 0 auto;
    height: calc(var(--header-h, 80px) + clamp(1.5rem, 6svh, 4rem));
  }

  .menu-spacer-bottom {
    flex: 1 1 0;
    /*
      Le plancher suit la hauteur disponible : sur un écran court, les
      derniers pixels doivent aller aux entrées du menu, pas à une marge
      décorative sous la dernière.
    */
    min-height: clamp(0rem, 2svh, 1.5rem);
  }

  .menu-footer {
    padding-bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
  }

  /*
   * Two viewports can share a width and differ hugely in height (a 390px
   * phone is 844px tall in portrait, 667px in some Android landscape
   * modes) — sizing the nav purely off width means either overflow on
   * short screens or a tiny island of text in a tall one. clamp()'s
   * preferred value reads from svh (the *small* viewport height, already
   * accounting for mobile browser chrome) so the link size and rhythm
   * scale with genuinely available vertical space, within bounds that
   * never overflow and never shrink past readable.
   */
  .menu-nav {
    gap: clamp(0.25rem, 1svh, 0.625rem);
  }

  .menu-link {
    font-size: clamp(1.375rem, 3.2svh, 1.875rem);
    line-height: 1.15;
  }

  @media (min-width: 640px) {
    .menu-content {
      /*
        La hauteur de l'en-tête était comptée DEUX fois : ici, et dans
        .menu-spacer-top juste au-dessus. Quatre-vingts pixels perdus en
        haut du panneau — invisible tant que la liste comptait sept
        entrées, fatal à la huitième : « À propos » passait sous la ligne
        de flottaison dès que la fenêtre descendait sous 844 px de haut,
        ce qui couvre la plupart des portables et l'Android en paysage.
        Le dégagement sous l'en-tête reste assuré par le spacer, qui est
        le seul à devoir s'en charger.
      */
      padding-top: 2rem;
    }

    .menu-nav {
      gap: clamp(0.5rem, 1.4svh, 1rem);
    }

    .menu-link {
      font-size: clamp(2rem, 5svh, 2.75rem);
      line-height: 1.1;
    }
  }

  @media (min-width: 1024px) {
    .menu-nav {
      gap: clamp(0.625rem, 1.6svh, 1.25rem);
    }

    .menu-link {
      font-size: clamp(2.5rem, 5.5svh, 3.5rem);
      line-height: 1.05;
    }
  }

  @media (min-width: 1920px) {
    .menu-nav {
      gap: 0.875rem;
    }

    .menu-link {
      font-size: 4.25rem;
      line-height: 1.05;
    }
  }

  .live-on-air {
    color: #e11d2e;
  }

  /*
   * Écran court, quelle que soit sa largeur.
   *
   * Les tailles ci-dessus se déclenchent sur la LARGEUR : un téléphone
   * couché fait 844 px de large et 390 px de haut, donc il hérite du
   * corps « grand écran » — dont le plancher de clamp() ignore la
   * hauteur. Résultat mesuré : cinq entrées sur huit hors de l'écran en
   * paysage. Cette règle passe après les précédentes et reprend la main
   * sur la seule dimension qui manque, en réduisant aussi les marges qui
   * coûtent le plus cher quand la hauteur est rare — le dégagement sous
   * l'en-tête en premier.
   */
  @media (max-height: 680px) {
    .menu-spacer-top {
      height: calc(var(--header-h, 80px) + 0.5rem);
    }

    .menu-content {
      padding-top: 0.75rem;
    }

    .menu-nav {
      gap: clamp(0.125rem, 0.8svh, 0.375rem);
    }

    .menu-link {
      font-size: clamp(1rem, 3.4svh, 1.5rem);
      line-height: 1.2;
    }
  }


  .live-on-air-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #e11d2e;
    animation: live-on-air-pulse 1.8s ease-in-out infinite;
  }

  @keyframes live-on-air-pulse {
    0%,
    100% {
      opacity: 1;
      box-shadow: 0 0 0 0 rgba(225, 29, 46, 0.45);
    }
    50% {
      opacity: 0.55;
      box-shadow: 0 0 0 4px rgba(225, 29, 46, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .live-on-air-dot {
      animation: none;
    }
  }

  /*
   * Logo mark is a single flattened image (circle + W baked into one file,
   * no separable layers) — isolating just the circle for rotation would
   * require reconstructing the artwork, which risks visible degradation.
   * Instead: a thin gold arc sits behind the untouched logo and rotates
   * slowly, giving the header a sense of life without touching a single
   * pixel of the actual mark. transform-only, so it's cheap, and covered
   * by the site's existing global prefers-reduced-motion rule (global.css
   * forces animation-duration to ~0 for every element under that setting).
   */
  .logo-ring {
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      transparent 250deg,
      var(--color-gold) 305deg,
      var(--color-gold-bright) 320deg,
      var(--color-gold) 335deg,
      transparent 360deg
    );
    opacity: 0.8;
    animation: logo-ring-spin 10s linear infinite;
  }

  @keyframes logo-ring-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<script>
  import { initNav } from "../../scripts/gsap/nav";
  import { initTheme } from "../../scripts/theme";
  initNav();
  initTheme();
</script>
