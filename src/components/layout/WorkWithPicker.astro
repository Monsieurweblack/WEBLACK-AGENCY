---
import { useTranslations, localizedPath, type Lang, type UiKey } from "../../i18n/utils";
import { CONTACT_SEGMENTS as segments } from "../../lib/contact";

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = useTranslations(lang);

const contactHref = localizedPath(lang, "/contact");
const uid = `${lang}-${Math.random().toString(36).slice(2, 8)}`;
---

{/*
  Point d'entrée commercial permanent du header. Jusqu'ici, la seule action
  de conversion visible en permanence n'existait pas : « Contact » ne
  vivait que dans le pied du menu plein écran, un clic après son ouverture,
  et sans jamais laisser deviner que six parcours différents attendaient
  derrière un unique bouton générique.

  Chaque lien mène directement au formulaire de /contact, profil déjà
  sélectionné (?profile=<segment>, lu par contact-segments.ts au chargement
  de la page) — jamais un second formulaire, jamais une segmentation
  parallèle. Réutilisé identiquement en pied de page d'accueil (CtaContact)
  quand ce chantier y arrivera.
*/}
<div class:list={["workwith-picker relative", className]} data-workwith-picker>
  <button
    type="button"
    id={`workwith-trigger-${uid}`}
    class="label-tracked inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center gap-2 whitespace-nowrap bg-(--color-gold) px-2.5 py-2 text-(--color-on-gold) transition-[background-color,transform] duration-300 hover:-translate-y-px hover:bg-(--color-gold-bright) sm:px-4"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls={`workwith-menu-${uid}`}
    aria-label={t("nav.workWith")}
    data-workwith-trigger
  >
    {/*
      En dessous de 640px, quatre commandes persistantes (Live, ce bouton,
      langue, menu) plus le logo dépassent la largeur d'un téléphone dès que
      ce bouton porte un texte — mesuré : 384px de groupe pour 375px
      d'écran, logo et « Live » collés l'un à l'autre. La glyphe seule tient
      la promesse commerciale sans dépasser ; le texte complet reste la
      norme à partir de sm:, où la place ne manque plus.
    */}
    <svg viewBox="0 0 20 20" class="h-4 w-4 shrink-0 sm:hidden" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
      <path d="M5 15 15 5M15 5H7M15 5v8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span class="hidden sm:inline">{t("nav.workWith")}</span>
    <svg viewBox="0 0 12 8" class="workwith-caret hidden h-2 w-2.5 shrink-0 sm:block" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M1 1.5 6 6.5 11 1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  {/*
    `fixed`, ancré au bord de l'en-tête (--header-h, mesuré en direct par
    nav.ts) plutôt qu'`absolute` sous le déclencheur : ce dernier n'est pas
    le dernier élément du cluster (Lang, Menu le suivent), donc un ancrage
    `right-0` relatif au déclencheur laissait le menu déborder hors écran
    sous ~455px de large — mesuré, pas supposé.
  */}
  <div
    id={`workwith-menu-${uid}`}
    class="workwith-menu fixed right-6 top-[calc(var(--header-h)+0.5rem)] z-[77] w-64 border border-(--color-line) bg-(--color-ink) py-2 shadow-[0_16px_40px_rgba(0,0,0,0.4)] md:right-10"
    role="menu"
    aria-label={t("nav.workWith")}
    data-workwith-menu
    data-state="closed"
    inert
  >
    <p class="label-tracked px-4 pb-2 pt-1 text-(--color-paper)/40">{t("nav.workWith.eyebrow")}</p>
    {
      segments.map((segment) => (
        <a
          href={`${contactHref}?profile=${segment}`}
          role="menuitem"
          class="block px-4 py-2.5 text-sm text-(--color-paper) transition-colors duration-150 hover:bg-(--color-ink-soft) hover:text-(--color-gold)"
        >
          {t(`contact.segment.${segment}` as UiKey)}
        </a>
      ))
    }
  </div>
</div>

<style>
  /*
   * Z-index délibéré : au-dessus de l'en-tête (76) qui le porte, au-dessous
   * de la fenêtre d'inscription (78) et des préférences de confidentialité
   * (80) — voir la carte d'empilement commentée dans Header.astro. Les deux
   * ne s'ouvrent jamais en même temps dans un usage normal, mais si c'était
   * le cas, ce sélecteur ne doit jamais passer devant une fenêtre modale.
   */
  .workwith-caret {
    transition: transform 200ms ease;
  }

  [data-workwith-trigger][aria-expanded="true"] .workwith-caret {
    transform: rotate(180deg);
  }

  .workwith-menu {
    opacity: 0;
    transform: translateY(-4px);
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 150ms ease,
      transform 150ms ease,
      visibility 150ms;
  }

  .workwith-menu[data-state="open"] {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .workwith-caret,
    .workwith-menu {
      transition: none;
    }
  }
</style>

<script>
  import { initWorkWithPicker } from "../../scripts/workwith-picker";
  initWorkWithPicker();
</script>
