---
import { useTranslations, type Lang } from "../../i18n/utils";
import { CONTACT_EMAIL } from "../../lib/contact";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/**
 * No backend exists yet (static build, host TBD): the form builds a mailto:
 * link from its fields and hands off to the visitor's own mail client rather
 * than posting to a server, so nothing here needs credentials or a backend.
 * The `profile` hidden field is set by the segment picker on the Contact page
 * before this form becomes visible.
 */
---

<form id="contact-form" data-contact-email={CONTACT_EMAIL} class="space-y-6" novalidate>
  <input type="hidden" id="contact-profile" name="profile" value="" />

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div>
      <label for="name" class="label-tracked text-(--color-paper)/70">{t("contact.form.name")}</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        class="mt-2 w-full border-0 border-b border-(--color-line) bg-transparent py-3 text-(--color-paper) outline-none transition-colors focus:border-(--color-gold)"
      />
    </div>
    <div>
      <label for="email" class="label-tracked text-(--color-paper)/70">{t("contact.form.email")}</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        class="mt-2 w-full border-0 border-b border-(--color-line) bg-transparent py-3 text-(--color-paper) outline-none transition-colors focus:border-(--color-gold)"
      />
    </div>
  </div>

  <div>
    <label for="organisation" class="label-tracked text-(--color-paper)/70">
      {t("contact.form.organisation")}
    </label>
    <input
      type="text"
      id="organisation"
      name="organisation"
      autocomplete="organization"
      class="mt-2 w-full border-0 border-b border-(--color-line) bg-transparent py-3 text-(--color-paper) outline-none transition-colors focus:border-(--color-gold)"
    />
  </div>

  <div>
    <label for="message" class="label-tracked text-(--color-paper)/70">{t("contact.form.message")}</label>
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      class="mt-2 w-full resize-none border-0 border-b border-(--color-line) bg-transparent py-3 text-(--color-paper) outline-none transition-colors focus:border-(--color-gold)"
    ></textarea>
  </div>

  <div class="flex flex-wrap items-center gap-6 pt-2">
    <button
      type="submit"
      class="inline-flex items-center justify-center bg-(--color-gold) px-8 py-4 text-sm font-semibold uppercase tracking-[0.08em] text-(--color-ink) transition-colors duration-300 hover:bg-(--color-gold-bright) disabled:opacity-60"
    >
      <span data-submit-label>{t("contact.form.submit")}</span>
    </button>
    <p class="text-sm text-(--color-paper)/50">
      {t("contact.form.mailto")}
      <a href={`mailto:${CONTACT_EMAIL}`} class="text-(--color-gold) underline">{CONTACT_EMAIL}</a>
    </p>
  </div>

  <p
    id="form-status"
    role="status"
    aria-live="polite"
    class="hidden text-sm"
    data-success-text={t("contact.form.success")}
    data-error-text={t("contact.form.error")}
    data-submitting-text={t("contact.form.submitting")}
    data-idle-text={t("contact.form.submit")}
  >
  </p>
</form>

<script>
  import { initContactForm } from "../../scripts/forms/contact-form";
  initContactForm();
</script>
