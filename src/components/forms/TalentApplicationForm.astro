---
import { useTranslations, type Lang, type UiKey } from "../../i18n/utils";
import { intlTagFor } from "../../i18n/locales";
import type { TalentApplicationSettingsData } from "../../lib/content";
import {
  COUNTRIES,
  DIAL_CODES,
  EXPERIENCE_DURATIONS,
  EXPERIENCE_LEVELS,
  EYE_COLORS,
  HAIR_COLORS,
  LANGUAGES,
  MEASUREMENT_LIMITS,
  MOBILITY_OPTIONS,
  MODEL_CATEGORIES,
  PROJECT_TYPES,
  SHOE_SIZE_LIMITS,
  SHOE_SYSTEMS,
  TALENT_CATEGORIES,
  TEXT_LIMITS,
  UPLOAD_LIMITS,
} from "../../../functions/lib/talentOptions.ts";

interface Props {
  lang: Lang;
  settings: TalentApplicationSettingsData;
}

const { lang, settings } = Astro.props;
const t = useTranslations(lang);
const k = (key: string) => t(key as UiKey);

/**
 * Formulaire en une seule page : cinq étapes, puis un écran de vérification,
 * affichés et masqués en JS — rien n'est retiré du DOM entre deux étapes, ce
 * qui conserve les réponses (et les photos déjà envoyées) sans jamais toucher
 * à localStorage (voir scripts/talent-application/form.ts).
 *
 * Toutes les listes viennent de functions/lib/talentOptions.ts, la même
 * source que la validation serveur : une option affichée ici est forcément
 * acceptée là-bas, et inversement. Les valeurs envoyées (name/value) sont
 * inchangées ; seule leur présentation l'est. Pays et langues sont nommés par
 * Intl.DisplayNames dans la langue de la page — jamais traduits à la main.
 *
 * Mineurs : aucun champ « représentant légal » dans le parcours public. Le
 * programme n'accepte que les 18 ans et plus ; le navigateur bloque la suite
 * du parcours, et le serveur (functions/lib/validation.ts) refuse de toute
 * façon toute date de naissance mineure tant que Sanity ne l'autorise pas.
 */

const collator = new Intl.Collator(intlTagFor(lang));
const capitalize = (value: string) => value.charAt(0).toLocaleUpperCase(intlTagFor(lang)) + value.slice(1);
const regionNames = new Intl.DisplayNames([intlTagFor(lang)], { type: "region" });
const languageNames = new Intl.DisplayNames([intlTagFor(lang)], { type: "language" });

const countries = COUNTRIES.map((code) => ({ code, name: regionNames.of(code) ?? code })).sort((a, b) =>
  collator.compare(a.name, b.name),
);
const languages = LANGUAGES.map((code) => ({ code, name: capitalize(languageNames.of(code) ?? code) })).sort((a, b) =>
  collator.compare(a.name, b.name),
);

const fieldClass = "form-input";
const labelClass = "label-tracked text-(--color-paper)/70";
const helpClass = "mt-2 text-sm text-(--color-paper)/50";
const required = `<span class="text-(--color-gold)" aria-hidden="true" data-label-extra>*</span>`;
const optional = `<span class="normal-case tracking-normal text-(--color-paper)/55" data-label-extra>· ${k("talentApplication.optional")}</span>`;

const stepNumbers = [1, 2, 3, 4, 5] as const;

const clientStrings = {
  progress: k("talentApplication.progress"),
  progressValidated: k("talentApplication.progress.validated"),
  stepTitles: [...stepNumbers.map((n) => k(`talentApplication.step.${n}.title`)), k("talentApplication.review.stepTitle")],
  stepperDone: k("talentApplication.stepper.done"),
  stepperCurrent: k("talentApplication.stepper.current"),
  stepperTodo: k("talentApplication.stepper.todo"),
  errorSummary: k("talentApplication.errorSummary"),
  navContinue: k("talentApplication.nav.continue"),
  navReview: k("talentApplication.nav.review"),
  navBackToReview: k("talentApplication.nav.backToReview"),
  navSubmit: k("talentApplication.nav.submit"),
  navSubmitting: k("talentApplication.nav.submitting"),
  navRetry: k("talentApplication.nav.retry"),
  photoChoose: k("talentApplication.photo.choose"),
  photoReplace: k("talentApplication.photo.replace"),
  photoPreparing: k("talentApplication.photo.preparing"),
  photoUploading: k("talentApplication.photo.uploading"),
  photoUploaded: k("talentApplication.photo.uploaded"),
  photoRetry: k("talentApplication.photo.retry"),
  photoError: k("talentApplication.photo.error"),
  photoInvalidType: k("talentApplication.photo.invalidType"),
  photoTooLarge: k("talentApplication.photo.tooLarge"),
  photoDropInvalid: k("talentApplication.photo.dropInvalid"),
  reviewEdit: k("talentApplication.review.edit"),
  reviewEmpty: k("talentApplication.review.empty"),
  reviewSections: {
    identity: k("talentApplication.review.section.identity"),
    contact: k("talentApplication.review.section.contact"),
    professional: k("talentApplication.review.section.professional"),
    measurements: k("talentApplication.review.section.measurements"),
    photos: k("talentApplication.review.section.photos"),
    languages: k("talentApplication.review.section.languages"),
    presentation: k("talentApplication.review.section.presentation"),
  },
  photoRoles: {
    portrait: k("talentApplication.photo.portrait"),
    profile: k("talentApplication.photo.profile"),
    full_length: k("talentApplication.photo.full_length"),
    extra: k("talentApplication.photo.extra"),
  },
  languagesSelected: k("talentApplication.languagesSelected"),
  languagesRemove: k("talentApplication.languages.remove"),
  charactersLeft: k("talentApplication.charactersLeft"),
  successDefault: k("talentApplication.success.default"),
  successEmailSent: k("talentApplication.success.emailSent"),
  successEmailPending: k("talentApplication.success.emailPending"),
  errors: {
    required: k("talentApplication.error.required"),
    email: k("talentApplication.error.email"),
    phone: k("talentApplication.error.phone"),
    country: k("talentApplication.error.country"),
    date: k("talentApplication.error.date"),
    url: k("talentApplication.error.url"),
    instagram: k("talentApplication.error.instagram"),
    range: k("talentApplication.error.range"),
    tooLong: k("talentApplication.error.tooLong"),
    invalidChoice: k("talentApplication.error.invalidChoice"),
    languages: k("talentApplication.error.languages"),
    photoRequired: k("talentApplication.error.photoRequired"),
    photoPending: k("talentApplication.error.photoPending"),
    photoExpired: k("talentApplication.error.photoExpired"),
    shoeSystem: k("talentApplication.error.shoeSystem"),
    rateLimited: k("talentApplication.error.rateLimited"),
    generic: k("talentApplication.error.generic"),
    validation: k("talentApplication.error.validation"),
    closed: k("talentApplication.error.closed"),
    unavailable: k("talentApplication.error.unavailable"),
    network: k("talentApplication.error.network"),
    photoReused: k("talentApplication.error.photoReused"),
  },
};

const clientConfig = {
  lang,
  minorsMessage: settings.minorsMessage ?? k("talentApplication.minors.title"),
  confirmationMessage: settings.confirmationMessage ?? "",
  privacyNoticeVersion: settings.privacyNoticeVersion,
  dialCodes: DIAL_CODES,
  modelCategories: MODEL_CATEGORIES,
  measurementLimits: MEASUREMENT_LIMITS,
  shoeSizeLimits: SHOE_SIZE_LIMITS,
  textLimits: TEXT_LIMITS,
  upload: UPLOAD_LIMITS,
};

const measureFields = [
  { name: "heightCm", always: true },
  { name: "chestCm", always: false },
  { name: "waistCm", always: false },
  { name: "hipsCm", always: false },
  { name: "inseamCm", always: false },
] as const;

const requiredRoles = ["portrait", "profile", "full_length"] as const;
const acceptTypes = UPLOAD_LIMITS.acceptedTypes.join(",");

/** Pictogrammes de cadrage : un trait fin, la silhouette attendue — jamais une photo d'exemple. */
const pictograms: Record<string, string> = {
  portrait:
    '<circle cx="40" cy="38" r="15"/><path d="M14 92c3-17 14-27 26-27s23 10 26 27"/>',
  profile:
    '<path d="M44 23c-10 0-17 7-17 17 0 6 3 11 7 14l-2 9h12l2-6c7-1 12-7 12-14l4-4-4-3c-1-8-7-13-14-13z"/><path d="M18 92c3-14 12-22 22-23"/>',
  full_length:
    '<circle cx="40" cy="14" r="7"/><path d="M40 21v34M28 30l12 6 12-6M40 55l-8 37M40 55l8 37"/>',
  extra: '<rect x="16" y="20" width="48" height="60"/><path d="M16 66l14-14 12 10 8-6 14 12"/><circle cx="52" cy="34" r="4"/>',
};
---

<form
  id="talent-application-form"
  class="application-form"
  novalidate
  data-config={JSON.stringify(clientConfig)}
  data-i18n={JSON.stringify(clientStrings)}
>
  <div class="lg:grid lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-16">
    {/* Progression : verticale et persistante sur grand écran, compacte sur téléphone. */}
    <nav class="application-stepper mb-10 lg:mb-0" aria-label={k("talentApplication.stepper.label")}>
      <div class="lg:sticky lg:top-[calc(var(--header-h,6rem)+2rem)]">
        <ol class="m-0 grid list-none grid-cols-6 gap-1.5 p-0 lg:grid-cols-1 lg:gap-0" data-stepper>
          {[...stepNumbers, 6].map((n) => (
            <li>
              <button type="button" class="stepper-item group" data-stepper-go={n} data-state={n === 1 ? "current" : "todo"} aria-current={n === 1 ? "step" : undefined}>
                <span class="stepper-bar" aria-hidden="true"></span>
                <span class="stepper-num font-display" aria-hidden="true">{n === 6 ? "✓" : `0${n}`}</span>
                <span class="stepper-text">
                  <span class="stepper-title">{n === 6 ? k("talentApplication.review.stepTitle") : k(`talentApplication.step.${n}.title`)}</span>
                  {n < 6 && <span class="stepper-summary">{k(`talentApplication.step.${n}.summary`)}</span>}
                </span>
                <span class="sr-only" data-stepper-state>{n === 1 ? clientStrings.stepperCurrent : clientStrings.stepperTodo}</span>
              </button>
            </li>
          ))}
        </ol>
        <p class="mt-3 text-sm text-(--color-paper)/50 lg:mt-6" data-progress-validated aria-live="polite"></p>
      </div>
    </nav>

    <div class="min-w-0">
      <div class="mb-10">
        <p class="label-tracked text-(--color-paper)/50" data-step-progress aria-live="polite"></p>
        <h2 class="font-display mt-3 text-3xl text-(--color-paper) outline-none sm:text-4xl" data-step-title tabindex="-1"></h2>
        <p class="mt-4 max-w-2xl text-sm text-(--color-paper)/50" data-required-note>{k("talentApplication.requiredNote")}</p>
      </div>

      <div hidden data-error-summary role="alert" class="error-summary mb-10 border-l-2 border-red-300 bg-(--color-ink-soft) px-5 py-4" tabindex="-1">
        <p class="text-sm text-(--color-paper)" data-error-summary-title></p>
        <ul class="mt-2 list-none space-y-1 p-0 text-sm" data-error-summary-list></ul>
      </div>

      <div class="application-steps">
        {/* 01 · Identité et coordonnées */}
        <fieldset data-step="1" class="space-y-8">
          <legend class="sr-only">{k("talentApplication.step.1.title")}</legend>
          <p class="notice">{k("talentApplication.step1.ageNotice")}</p>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <label for="firstName" class={labelClass}>{k("talentApplication.field.firstName")} <Fragment set:html={required} /></label>
              <input id="firstName" name="firstName" type="text" required maxlength={TEXT_LIMITS.name} autocomplete="given-name" class={fieldClass} aria-describedby="firstName-error" />
              <p id="firstName-error" class="field-error" data-error-for="firstName" hidden></p>
            </div>
            <div>
              <label for="lastName" class={labelClass}>{k("talentApplication.field.lastName")} <Fragment set:html={required} /></label>
              <input id="lastName" name="lastName" type="text" required maxlength={TEXT_LIMITS.name} autocomplete="family-name" class={fieldClass} aria-describedby="lastName-error" />
              <p id="lastName-error" class="field-error" data-error-for="lastName" hidden></p>
            </div>
          </div>

          <div>
            <label for="birthDate" class={labelClass}>{k("talentApplication.field.birthDate")} <Fragment set:html={required} /></label>
            <input id="birthDate" name="birthDate" type="date" required autocomplete="bday" min="1925-01-01" class={`${fieldClass} sm:max-w-xs`} aria-describedby="birthDate-help birthDate-error" />
            <p id="birthDate-help" class={helpClass}>{k("talentApplication.help.birthDate")}</p>
            <p id="birthDate-error" class="field-error" data-error-for="birthDate" hidden></p>
          </div>

          <div hidden data-minor-block class="border border-(--color-gold)/40 bg-(--color-ink-soft) p-5 text-(--color-paper)/85" role="alert"></div>

          <div data-minor-gated class="space-y-8">
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <label for="city" class={labelClass}>{k("talentApplication.field.city")} <Fragment set:html={required} /></label>
                <input id="city" name="city" type="text" required maxlength={TEXT_LIMITS.city} autocomplete="address-level2" class={fieldClass} aria-describedby="city-error" />
                <p id="city-error" class="field-error" data-error-for="city" hidden></p>
              </div>
              <div>
                <label for="countrySearch" class={labelClass}>{k("talentApplication.field.country")} <Fragment set:html={required} /></label>
                <input id="countrySearch" type="text" list="country-options" autocomplete="country-name" class={fieldClass} aria-describedby="countrySearch-help countrySearch-error" data-country-search />
                <input type="hidden" name="country" data-country-code />
                <datalist id="country-options">
                  {countries.map((c) => <option value={c.name} data-code={c.code} />)}
                </datalist>
                <p id="countrySearch-help" class={helpClass}>{k("talentApplication.help.country")}</p>
                <p id="countrySearch-error" class="field-error" data-error-for="country" hidden></p>
              </div>
            </div>

            <div>
              <label for="email" class={labelClass}>{k("talentApplication.field.email")} <Fragment set:html={required} /></label>
              <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" inputmode="email" class={fieldClass} aria-describedby="email-help email-error" />
              <p id="email-help" class={helpClass}>{k("talentApplication.help.email")}</p>
              <p id="email-error" class="field-error" data-error-for="email" hidden></p>
            </div>

            <div>
              <span id="phone-label" class={labelClass}>{k("talentApplication.field.phone")} <Fragment set:html={required} /></span>
              <div class="mt-2 grid grid-cols-[6.5rem_1fr] gap-4">
                <div>
                  <label for="phoneDialCode" class="sr-only">{k("talentApplication.field.phoneDialCode")}</label>
                  <input id="phoneDialCode" type="text" inputmode="tel" autocomplete="tel-country-code" placeholder="+33" maxlength="5" class={`${fieldClass} mt-0`} aria-describedby="phone-help phone-error" data-dial-code />
                </div>
                <div>
                  <label for="phoneNumber" class="sr-only">{k("talentApplication.field.phone")}</label>
                  <input id="phoneNumber" type="tel" inputmode="tel" autocomplete="tel-national" maxlength="20" class={`${fieldClass} mt-0`} aria-labelledby="phone-label" aria-describedby="phone-help phone-error" />
                </div>
              </div>
              <p id="phone-help" class={helpClass}>{k("talentApplication.help.phone")}</p>
              <p id="phone-error" class="field-error" data-error-for="phone" hidden></p>
            </div>
          </div>
        </fieldset>

        {/* 02 · Profil et expérience */}
        <fieldset data-step="2" hidden class="space-y-10">
          <legend class="sr-only">{k("talentApplication.step.2.title")}</legend>
          <div role="radiogroup" aria-labelledby="category-label" aria-describedby="category-error">
            <p id="category-label" class={labelClass}>{k("talentApplication.field.category")} <Fragment set:html={required} /></p>
            <div class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2 xl:grid-cols-3">
              {TALENT_CATEGORIES.map((value) => (
                <label class="choice">
                  <input type="radio" name="category" value={value} class="choice-input" data-category />
                  <span class="choice-mark" aria-hidden="true"></span>
                  <span class="choice-label">{k(`talentApplication.option.category.${value}`)}</span>
                </label>
              ))}
            </div>
            <p id="category-error" class="field-error" data-error-for="category" hidden></p>
          </div>
          <div hidden data-category-other>
            <label for="categoryOther" class={labelClass}>{k("talentApplication.field.categoryOther")} <Fragment set:html={required} /></label>
            <input id="categoryOther" name="categoryOther" type="text" maxlength={TEXT_LIMITS.categoryOther} class={fieldClass} aria-describedby="categoryOther-error" />
            <p id="categoryOther-error" class="field-error" data-error-for="categoryOther" hidden></p>
          </div>

          <div class="border-l border-(--color-gold) pl-5">
            <p class="font-display text-xl text-(--color-paper)">{k("talentApplication.beginnersWelcome")}</p>
            <p class="mt-1 text-sm text-(--color-paper)/60">{k("talentApplication.beginnersWelcome.text")}</p>
          </div>

          <div role="radiogroup" aria-labelledby="experienceLevel-label" aria-describedby="experience-help experienceLevel-error">
            <p id="experienceLevel-label" class={labelClass}>{k("talentApplication.field.experienceLevel")} <Fragment set:html={required} /></p>
            <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4">
              {EXPERIENCE_LEVELS.map((value) => (
                <label class="choice choice-compact">
                  <input type="radio" name="experienceLevel" value={value} class="choice-input" />
                  <span class="choice-label">{k(`talentApplication.option.level.${value}`)}</span>
                </label>
              ))}
            </div>
            <p id="experienceLevel-error" class="field-error" data-error-for="experienceLevel" hidden></p>
          </div>

          <div role="radiogroup" aria-labelledby="experienceDuration-label" aria-describedby="experience-help experienceDuration-error">
            <p id="experienceDuration-label" class={labelClass}>{k("talentApplication.field.experienceDuration")} <Fragment set:html={required} /></p>
            <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-5">
              {EXPERIENCE_DURATIONS.map((value) => (
                <label class="choice choice-compact">
                  <input type="radio" name="experienceDuration" value={value} class="choice-input" />
                  <span class="choice-label">{k(`talentApplication.option.duration.${value}`)}</span>
                </label>
              ))}
            </div>
            <p id="experienceDuration-error" class="field-error" data-error-for="experienceDuration" hidden></p>
            <p id="experience-help" class={helpClass}>{k("talentApplication.help.experience")}</p>
          </div>

          <div>
            <label for="portfolioLinks" class={labelClass}>{k("talentApplication.field.portfolioLinks")} <Fragment set:html={optional} /></label>
            <textarea id="portfolioLinks" name="portfolioLinks" rows="3" inputmode="url" class={`${fieldClass} resize-none`} aria-describedby="portfolioLinks-help portfolioLinks-error"></textarea>
            <p id="portfolioLinks-help" class={helpClass}>{k("talentApplication.help.portfolioLinks")}</p>
            <p id="portfolioLinks-error" class="field-error" data-error-for="portfolioLinks" hidden></p>
          </div>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <label for="instagram" class={labelClass}>{k("talentApplication.field.instagram")} <Fragment set:html={optional} /></label>
              <input id="instagram" name="instagram" type="text" maxlength={TEXT_LIMITS.instagram} autocomplete="off" class={fieldClass} aria-describedby="instagram-help instagram-error" />
              <p id="instagram-help" class={helpClass}>{k("talentApplication.help.instagram")}</p>
              <p id="instagram-error" class="field-error" data-error-for="instagram" hidden></p>
            </div>
            <div>
              <label for="currentAgency" class={labelClass}>{k("talentApplication.field.currentAgency")} <Fragment set:html={optional} /></label>
              <input id="currentAgency" name="currentAgency" type="text" maxlength={TEXT_LIMITS.agency} class={fieldClass} aria-describedby="currentAgency-error" />
              <p id="currentAgency-error" class="field-error" data-error-for="currentAgency" hidden></p>
            </div>
          </div>
          <div>
            <label for="exclusivity" class={labelClass}>{k("talentApplication.field.exclusivity")} <Fragment set:html={optional} /></label>
            <input id="exclusivity" name="exclusivity" type="text" maxlength={TEXT_LIMITS.exclusivity} class={fieldClass} aria-describedby="exclusivity-error" />
            <p id="exclusivity-error" class="field-error" data-error-for="exclusivity" hidden></p>
          </div>
        </fieldset>

        {/* 03 · Profil et mensurations */}
        <fieldset data-step="3" hidden class="space-y-8">
          <legend class="sr-only">{k("talentApplication.step.3.title")}</legend>
          <p class="notice">{k("talentApplication.field.measurementsNote")}</p>
          <p hidden class="text-sm text-(--color-gold)" data-measurements-limited>{k("talentApplication.field.measurementsLimitedNote")}</p>

          <div class="grid grid-cols-2 gap-6 sm:grid-cols-3">
            {measureFields.map(({ name, always }) => (
              <div data-measure={always ? "always" : "model"}>
                <label for={name} class={labelClass}>{k(`talentApplication.field.${name}`)}</label>
                <div class="unit-field">
                  <input
                    id={name}
                    name={name}
                    type="text"
                    inputmode="decimal"
                    class={fieldClass}
                    placeholder={`${MEASUREMENT_LIMITS[name][0]}–${MEASUREMENT_LIMITS[name][1]}`}
                    aria-describedby={`${name}-error`}
                    data-decimal
                    data-min={MEASUREMENT_LIMITS[name][0]}
                    data-max={MEASUREMENT_LIMITS[name][1]}
                  />
                  <span class="unit" aria-hidden="true">{k("talentApplication.option.unit.cm")}</span>
                </div>
                <p id={`${name}-error`} class="field-error" data-error-for={name} hidden></p>
              </div>
            ))}
          </div>

          <div class="grid grid-cols-2 gap-6 sm:grid-cols-3" data-measure="model">
            <div>
              <label for="shoeSize" class={labelClass}>{k("talentApplication.field.shoeSize")}</label>
              <input id="shoeSize" name="shoeSize" type="text" inputmode="decimal" class={fieldClass} placeholder={`${SHOE_SIZE_LIMITS[0]}–${SHOE_SIZE_LIMITS[1]}`} aria-describedby="shoeSize-error" data-decimal data-min={SHOE_SIZE_LIMITS[0]} data-max={SHOE_SIZE_LIMITS[1]} />
              <p id="shoeSize-error" class="field-error" data-error-for="shoeSize" hidden></p>
            </div>
            <div>
              <label for="shoeSystem" class={labelClass}>{k("talentApplication.field.shoeSystem")}</label>
              <select id="shoeSystem" name="shoeSystem" class={fieldClass} aria-describedby="shoeSystem-error">
                <option value="">{k("talentApplication.selectPlaceholder")}</option>
                {SHOE_SYSTEMS.map((value) => <option value={value}>{value}</option>)}
              </select>
              <p id="shoeSystem-error" class="field-error" data-error-for="shoeSystem" hidden></p>
            </div>
            <div class="col-span-2 sm:col-span-1">
              <label for="clothingSize" class={labelClass}>{k("talentApplication.field.clothingSize")}</label>
              <input id="clothingSize" name="clothingSize" type="text" maxlength={TEXT_LIMITS.clothingSize} class={fieldClass} aria-describedby="clothingSize-error" />
              <p id="clothingSize-error" class="field-error" data-error-for="clothingSize" hidden></p>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <label for="eyeColor" class={labelClass}>{k("talentApplication.field.eyeColor")}</label>
              <select id="eyeColor" name="eyeColor" class={fieldClass}>
                <option value="">{k("talentApplication.selectPlaceholder")}</option>
                {EYE_COLORS.map((value) => <option value={value}>{k(`talentApplication.option.eye.${value}`)}</option>)}
              </select>
            </div>
            <div>
              <label for="hairColor" class={labelClass}>{k("talentApplication.field.hairColor")}</label>
              <select id="hairColor" name="hairColor" class={fieldClass}>
                <option value="">{k("talentApplication.selectPlaceholder")}</option>
