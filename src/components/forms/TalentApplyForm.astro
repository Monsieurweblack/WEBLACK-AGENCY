---
import { useTranslations, type Lang, type UiKey } from "../../i18n/utils";
import { CONTACT_EMAIL } from "../../lib/contact";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const categories = ["models", "creatives", "artists", "designers", "photographers", "stylists", "other"] as const;

/**
 * No backend exists yet: this form builds a mailto: link from its fields,
 * same mechanism as ContactForm — see that file for the reasoning.
 */
---

<form id="talent-apply-form" data-contact-email={CONTACT_EMAIL} class="space-y-6" novalidate>
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div>
      <label for="firstName" class="label-tracked text-(--color-paper)/70">{t("talent.apply.firstName")}</label>
      <input
        type="text"
        id="firstName"
        name="firstName"
        required
        autocomplete="given-name"
        class="mt-2 w-full border-0 border-b border-(--color-line) bg-transparent py-3 text-(--color-paper) outline-none transition-colors focus:border-(--color-gold)"
      />
    </div>
    <div>
      <label for="lastName" class="label-tracked text-(--color-paper)/70">{t("talent.apply.lastName")}</label>
      <input
        type="text"
        id="lastName"
        name="lastName"
        required
        autocomplete="family-name"
        class="mt-2 w-full border-0 border-b border-(--color-line) bg-transparent py-3 text-(--color-paper) outline-none transition-colors focus:border-(--color-gold)"
      />
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div>
      <label for="email" class="label-tracked text-(--color-paper)/70">{t("talent.apply.email")}</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        class="mt-2 w-full border-0 border-b border-(--color-line) bg-transparent py-3 text-(--color-paper) outline-none transition-colors focus:border-(--color-gold)"
      />
    </div>
    <div>
      <label for="phone" class="label-tracked text-(--color-paper)/70">{t("talent.apply.phone")}</label>
      <input
        type="tel"
        id="phone"
        name="phone"
        autocomplete="tel"
        class="mt-2 w-full border-0 border-b border-(--color-line) bg-transparent py-3 text-(--color-paper) outline-none transition-colors focus:border-(--color-gold)"
      />
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div>
      <label for="category" class="label-tracked text-(--color-paper)/70">{t("talent.apply.category")}</label>
      <select
        id="category"
        name="category"
        required
        class="mt-2 w-full border-0 border-b border-(--color-line) bg-transparent py-3 text-(--color-paper) outline-none transition-colors focus:border-(--color-gold)"
      >
        <option value="" disabled selected></option>
        {categories.map((category) => <option value={category}>{t(`talent.category.${category}` as UiKey)}</option>)}
      </select>
    </div>
    <div>
      <label for="location" class="label-tracked text-(--color-paper)/70">{t("talent.apply.location")}</label>
      <input
        type="text"
        id="location"
        name="location"
        required
        class="mt-2 w-full border-0 border-b border-(--color-line) bg-transparent py-3 text-(--color-paper) outline-none transition-colors focus:border-(--color-gold)"
      />
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div>
      <label for="portfolio" class="label-tracked text-(--color-paper)/70">{t("talent.apply.portfolio")}</label>
      <input
        type="url"
        id="portfolio"
        name="portfolio"
        class="mt-2 w-full border-0 border-b border-(--color-line) bg-transparent py-3 text-(--color-paper) outline-none transition-colors focus:border-(--color-gold)"
      />
    </div>
    <div>
      <label for="socials" class="label-tracked text-(--color-paper)/70">{t("talent.apply.socials")}</label>
      <input
        type="text"
        id="socials"
        name="socials"
        class="mt-2 w-full border-0 border-b border-(--color-line) bg-transparent py-3 text-(--color-paper) outline-none transition-colors focus:border-(--color-gold)"
      />
    </div>
  </div>

  <div>
    <label for="experience" class="label-tracked text-(--color-paper)/70">{t("talent.apply.experience")}</label>
    <textarea
      id="experience"
      name="experience"
      rows="4"
      class="mt-2 w-full resize-none border-0 border-b border-(--color-line) bg-transparent py-3 text-(--color-paper) outline-none transition-colors focus:border-(--color-gold)"
    ></textarea>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
    <div>
      <label for="languages" class="label-tracked text-(--color-paper)/70">{t("talent.apply.languages")}</label>
      <input
        type="text"
        id="languages"
        name="languages"
        class="mt-2 w-full border-0 border-b border-(--color-line) bg-transparent py-3 text-(--color-paper) outline-none transition-colors focus:border-(--color-gold)"
      />
    </div>
    <div>
      <label for="availability" class="label-tracked text-(--color-paper)/70">{t("talent.apply.availability")}</label>
      <input
        type="text"
        id="availability"
        name="availability"
        class="mt-2 w-full border-0 border-b border-(--color-line) bg-transparent py-3 text-(--color-paper) outline-none transition-colors focus:border-(--color-gold)"
      />
    </div>
    <div>
      <label for="mobility" class="label-tracked text-(--color-paper)/70">{t("talent.apply.mobility")}</label>
      <input
        type="text"
        id="mobility"
        name="mobility"
        class="mt-2 w-full border-0 border-b border-(--color-line) bg-transparent py-3 text-(--color-paper) outline-none transition-colors focus:border-(--color-gold)"
      />
    </div>
  </div>

  <div>
    <label for="message" class="label-tracked text-(--color-paper)/70">{t("talent.apply.message")}</label>
    <textarea
      id="message"
      name="message"
      rows="4"
      class="mt-2 w-full resize-none border-0 border-b border-(--color-line) bg-transparent py-3 text-(--color-paper) outline-none transition-colors focus:border-(--color-gold)"
    ></textarea>
  </div>

  <div class="flex items-start gap-3">
    <input
      type="checkbox"
      id="consent"
      name="consent"
      required
      class="mt-1 h-4 w-4 shrink-0 border border-(--color-line) bg-transparent accent-(--color-gold)"
    />
    <label for="consent" class="text-sm text-(--color-paper)/60">{t("talent.apply.consent")}</label>
  </div>

  <div class="flex flex-wrap items-center gap-6 pt-2">
    <button
      type="submit"
      class="inline-flex items-center justify-center bg-(--color-gold) px-8 py-4 text-sm font-semibold uppercase tracking-[0.08em] text-(--color-ink) transition-colors duration-300 hover:bg-(--color-gold-bright) disabled:opacity-60"
    >
      <span data-submit-label>{t("talent.apply.submit")}</span>
    </button>
  </div>

  <p
    id="form-status"
    role="status"
    aria-live="polite"
    class="hidden text-sm"
    data-success-text={t("contact.form.success")}
    data-error-text={t("contact.form.error")}
    data-submitting-text={t("contact.form.submitting")}
  >
  </p>
</form>

<script>
  import { initTalentApplyForm } from "../../scripts/forms/talent-apply-form";
  initTalentApplyForm();
</script>
