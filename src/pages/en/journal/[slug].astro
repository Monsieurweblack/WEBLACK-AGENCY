---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import JournalDetail from "../../../components/pages/JournalDetail.astro";
import { useTranslations, localizedPath } from "../../../i18n/utils";
import { getEntriesByLang } from "../../../lib/content";

/**
 * Not every article is published in both languages, and even paired
 * articles don't always share the same slug (see the FR/EN NTA pair) — the
 * language switcher can't assume a same-slug counterpart exists. When it
 * doesn't, `altLangHref` sends it to the other language's Journal index
 * instead of a 404.
 */
export async function getStaticPaths() {
  const [entries, frEntries] = await Promise.all([
    getEntriesByLang("journal", "en"),
    getEntriesByLang("journal", "fr"),
  ]);
  const frSlugs = new Set(frEntries.map((entry) => entry.data.slug));
  return entries.map((article) => ({
    params: { slug: article.data.slug },
    props: { article, hasAltLang: frSlugs.has(article.data.slug) },
  }));
}

const { article, hasAltLang } = Astro.props;
const lang = "en" as const;
const t = useTranslations(lang);
const altLangHref = hasAltLang ? undefined : localizedPath("fr", "/journal");
---

<BaseLayout
  lang={lang}
  title={article.data.seo?.title ?? `${article.data.title} — ${t("nav.journal")}`}
  description={article.data.seo?.description ?? article.data.excerpt}
  image={article.data.coverImage.url}
  imageAlt={article.data.coverImage.alt}
  altLangHref={altLangHref}
>
  <JournalDetail lang={lang} article={article} />
</BaseLayout>

<script>
  import { initScrollChoreography } from "../../../scripts/gsap/scroll-choreography";
  initScrollChoreography();
</script>
