---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import JournalDetail from "../../../components/pages/JournalDetail.astro";
import { localizedPath, type TranslationMap } from "../../../i18n/utils";
import { getEntriesByLang } from "../../../lib/content";
import { resolveContentId } from "../../../lib/content-graph";

/**
 * Not every article is published in both languages, and even paired
 * articles don't always share the same slug (see the FR/EN NTA pair) —
 * matched here by contentId (src/lib/content-graph.ts), not by slug, so a
 * genuinely paired article is still found even when its slug differs.
 * A locale absent from `translations` has no known counterpart for this
 * article: never fabricate one (see src/i18n/utils.ts `resolveTranslations`).
 */
export async function getStaticPaths() {
  const [entries, frEntries] = await Promise.all([
    getEntriesByLang("journal", "en"),
    getEntriesByLang("journal", "fr"),
  ]);
  const frByContentId = new Map(
    frEntries.map((entry) => [resolveContentId("journal", "fr", entry.data.slug), entry]),
  );
  return entries.map((article) => {
    const frMatch = frByContentId.get(resolveContentId("journal", "en", article.data.slug));
    // Always an explicit map (possibly {}), never undefined — see the FR
    // route's identical comment for why that distinction matters here.
    const translations: TranslationMap = frMatch
      ? { fr: localizedPath("fr", `/journal/${frMatch.data.slug}/`) }
      : {};
    return {
      params: { slug: article.data.slug },
      props: { article, translations },
    };
  });
}

const { article, translations } = Astro.props;
const lang = "en" as const;
---

<BaseLayout
  lang={lang}
  title={article.data.seo?.title ?? article.data.title}
  description={article.data.seo?.description ?? article.data.excerpt}
  image={article.data.coverImage.url}
  imageAlt={article.data.coverImage.alt}
  translations={translations}
>
  <JournalDetail lang={lang} article={article} />
</BaseLayout>

<script>
  import { initScrollChoreography } from "../../../scripts/gsap/scroll-choreography";
  initScrollChoreography();
</script>
