---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import OpportunityDetail from "../../../components/pages/OpportunityDetail.astro";
import { getOpportunities } from "../../../lib/content";
import type { Opportunity } from "../../../lib/opportunities";
import { OPPORTUNITY_HERO_SIZES } from "../../../lib/opportunity-copy";

/**
 * Une page par annonce Sanity en ligne, clôturée ou archivée (jamais « en
 * vérification » ni brouillon) — voir src/lib/opportunities.ts.
 */
export async function getStaticPaths() {
  const opportunities = await getOpportunities();
  return opportunities.map((opportunity) => ({ params: { slug: opportunity.slug }, props: { opportunity } }));
}

const lang = "en" as const;
const { opportunity } = Astro.props as { opportunity: Opportunity };
const x = opportunity.text[lang];
---

<BaseLayout
  lang={lang}
  title={x.seoTitle ?? `${x.title} · Opportunities`}
  description={x.seoDescription ?? [x.summary, [x.location, x.eventDate].filter(Boolean).join(", ")].join(" ") + "."}
  image={opportunity.ogImage}
  imageAlt={opportunity.image?.alt[lang]}
  lcpImage={opportunity.image ? { src: opportunity.image.src, width: opportunity.image.width, sizes: OPPORTUNITY_HERO_SIZES } : undefined}
>
  <OpportunityDetail lang={lang} opportunity={opportunity} />
</BaseLayout>
