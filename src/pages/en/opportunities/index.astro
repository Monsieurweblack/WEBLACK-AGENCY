---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import OpportunityList from "../../../components/pages/OpportunityList.astro";
import { OPPORTUNITY_COPY } from "../../../lib/opportunity-copy";
import { getOpportunities } from "../../../lib/content";

/** Aperçu de partage : visuel de l'annonce non archivée la plus proche de sa date limite, s'il existe. */
const lead = (await getOpportunities()).find((o) => o.status !== "archived" && o.ogImage);

const lang = "en" as const;
const c = OPPORTUNITY_COPY[lang];
---

<BaseLayout lang={lang} title={c.catalogSeoTitle} description={c.catalogLead} image={lead?.ogImage} imageAlt={lead?.image?.alt[lang]}>
  <OpportunityList lang={lang} />
</BaseLayout>
