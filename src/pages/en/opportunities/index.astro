---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import OpportunityList from "../../../components/pages/OpportunityList.astro";
import { OPPORTUNITY_COPY } from "../../../lib/opportunity-copy";
import { OPPORTUNITIES } from "../../../data/opportunities";

/** Aperçu de partage : visuel de l'annonce la plus proche de sa date limite, s'il existe. */
const lead = [...OPPORTUNITIES].sort((a, b) => Date.parse(a.deadline) - Date.parse(b.deadline)).find((o) => o.ogImage);

const lang = "en" as const;
const c = OPPORTUNITY_COPY[lang];
---

<BaseLayout lang={lang} title={c.catalogSeoTitle} description={c.catalogLead} image={lead?.ogImage} imageAlt={lead?.image?.alt[lang]}>
  <OpportunityList lang={lang} />
</BaseLayout>
