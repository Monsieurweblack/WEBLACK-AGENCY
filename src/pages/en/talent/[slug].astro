---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TalentDetail from "../../../components/pages/TalentDetail.astro";
import { useTranslations } from "../../../i18n/utils";
import { getEntriesByLang } from "../../../lib/content";

export async function getStaticPaths() {
  const entries = await getEntriesByLang("talent", "en");
  return entries.map((talent) => ({ params: { slug: talent.data.slug }, props: { talent } }));
}

const { talent } = Astro.props;
const lang = "en" as const;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={`${talent.data.name} — ${t("nav.talent")}`}
  description={`${talent.data.role} · ${talent.data.country}`}
  image={talent.data.portraitImage.url}
>
  <TalentDetail lang={lang} talent={talent} />
</BaseLayout>

<script>
  import { initScrollChoreography } from "../../../scripts/gsap/scroll-choreography";
  initScrollChoreography();
</script>
