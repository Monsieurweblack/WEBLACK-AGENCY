---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TalentApplication from "../../../components/pages/TalentApplication.astro";
import { useTranslations } from "../../../i18n/utils";
import { getTalentApplicationSettings } from "../../../lib/content";
import { TALENT_APPLICATION_IMAGE } from "../../../lib/hero-images";

const lang = "en" as const;
const t = useTranslations(lang);

const settings = await getTalentApplicationSettings(lang);
---

<BaseLayout
  lang={lang}
  title={settings.seoTitle || t("talentApplication.seo.title")}
  description={settings.seoDescription || settings.welcomeSubtitle || t("talentApplication.welcome.subtitle")}
  lcpImage={settings.welcomeImage ? undefined : TALENT_APPLICATION_IMAGE}
>
  <TalentApplication lang={lang} settings={settings} />
</BaseLayout>
