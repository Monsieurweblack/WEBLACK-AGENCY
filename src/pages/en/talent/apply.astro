---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TalentApplyForm from "../../../components/forms/TalentApplyForm.astro";
import { useTranslations, localizedPath } from "../../../i18n/utils";

const lang = "en" as const;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t("talent.apply.title")} description={t("talent.apply.lead")}>
  <section class="bg-(--color-ink) px-6 pb-24 pt-40 md:px-10 md:pb-32">
    <div class="mx-auto max-w-3xl">
      <a
        href={localizedPath(lang, "/talent")}
        class="label-tracked text-(--color-paper)/60 transition-colors hover:text-(--color-gold)"
      >
        &larr; {t("talent.back")}
      </a>
      <div class="mt-8" data-reveal>
        <h1 class="font-display text-4xl text-(--color-paper) sm:text-5xl">{t("talent.apply.title")}</h1>
        <p class="mt-6 text-(--color-paper)/70">{t("talent.apply.lead")}</p>
      </div>

      <div class="mt-14" data-reveal data-reveal-delay="0.1">
        <TalentApplyForm lang={lang} />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initScrollChoreography } from "../../../scripts/gsap/scroll-choreography";
  initScrollChoreography();
</script>
