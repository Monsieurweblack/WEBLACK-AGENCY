---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations, localizedPath } from "../../i18n/utils";
import { CONTACT_EMAIL } from "../../lib/contact";

const lang = "en" as const;
const t = useTranslations(lang);
---

