---
import BaseLayout from "../layouts/BaseLayout.astro";
import DivisionPage from "../components/pages/DivisionPage.astro";
import { useTranslations } from "../i18n/utils";

const lang = "fr" as const;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t("consulting.seo.title")} description={t("consulting.hero.lead")}>
  <DivisionPage lang={lang} division="consulting" />
</BaseLayout>
