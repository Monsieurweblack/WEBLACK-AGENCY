---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardWork from "../../components/cards/CardWork.astro";
import SelectedWorkEditorial from "../../components/sections/SelectedWorkEditorial.astro";
import CtaContact from "../../components/sections/CtaContact.astro";
import { useTranslations } from "../../i18n/utils";
import { getEntriesByLang, sortByDateDesc } from "../../lib/content";

const lang = "fr" as const;
const t = useTranslations(lang);
const work = sortByDateDesc(await getEntriesByLang("work", lang));
---

<BaseLayout lang={lang} title={t("selectedwork.hero.title")} description={t("selectedwork.seo.description")}>
  <section class="bg-(--color-ink) px-6 pb-16 pt-40 md:px-10">
    <div class="mx-auto max-w-(--container-content)" data-reveal>
      <p class="label-tracked label-tracked-dot text-(--color-gold)">{t("selectedwork.hero.eyebrow")}</p>
      <h1 class="font-display mt-4 max-w-3xl text-4xl text-(--color-paper) sm:text-5xl">
        {t("selectedwork.hero.title")}
      </h1>
    </div>
  </section>

  <section class="bg-(--color-ink) px-6 pb-24 md:px-10 md:pb-32">
    <div class="mx-auto max-w-(--container-content)">
      {
        /*
          La grille asymétrique ne s'enclenche qu’à partir de trois projets :
          son rythme se joue par tranches de trois, et appliqué à deux
          éléments il se lit comme une mise en page ratée plutôt que comme un
          parti pris. En dessous, le traitement éditorial (le même qu'à
          l'accueil — voir SelectedWorkEditorial.astro) donne à chaque
          projet tout l'espace que sa place dans une sélection courte
          justifie, plutôt qu'une grille qui présuppose une troisième entrée
          absente.
        */
        work.length === 0 ? (
          <p class="text-(--color-paper)/60">{t("selectedwork.empty")}</p>
        ) : work.length >= 3 ? (
          <div class="work-grid-asymmetric">
            {work.map((item, i) => (
              <CardWork lang={lang} work={item} index={i} />
            ))}
          </div>
        ) : (
          <SelectedWorkEditorial lang={lang} work={work} />
        )
      }
    </div>
  </section>

  <CtaContact lang={lang} />
</BaseLayout>

<script>
  import { initScrollChoreography } from "../../scripts/gsap/scroll-choreography";
  initScrollChoreography();
</script>
