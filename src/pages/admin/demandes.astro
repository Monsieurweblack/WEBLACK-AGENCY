---
import "../../styles/global.css";

/**
 * Pipeline commercial — outil interne, même principe que
 * /admin/candidatures : aucune donnée au build, tout est lu en direct via
 * /api/admin/inquiries* avec le cookie de session admin (même connexion).
 * Jamais indexée (astro.config.mjs NOINDEX_PATHS + balise robots).
 */
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Demandes commerciales — Administration WEBLACK</title>
  </head>
  <body class="min-h-screen bg-(--color-ink) text-(--color-paper)">
    <div class="mx-auto max-w-6xl px-6 py-16 md:px-10">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h1 class="font-display text-3xl">Demandes commerciales</h1>
        <a href="/admin/candidatures/" class="label-tracked text-(--color-paper)/50 hover:text-(--color-gold)">Candidatures Talent &rarr;</a>
      </div>

      <form id="login-form" class="mt-10 max-w-sm space-y-4">
        <div>
          <label for="password" class="label-tracked text-(--color-paper)/70">Mot de passe</label>
          <input id="password" name="password" type="password" required autocomplete="current-password" class="form-input" />
        </div>
        <button type="submit" class="inline-flex min-h-12 items-center justify-center bg-(--color-gold) px-8 py-3 text-sm font-semibold uppercase tracking-[0.08em] text-(--color-on-gold) hover:bg-(--color-gold-bright)">
          Se connecter
        </button>
        <p id="login-status" role="status" aria-live="polite" class="min-h-[1.25em] text-sm text-red-400"></p>
      </form>

      <div id="dashboard" hidden class="mt-10">
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-(--color-line) pb-4">
          <div class="flex flex-wrap gap-2" id="status-filters"></div>
          <button id="logout-button" class="label-tracked text-(--color-paper)/50 hover:text-(--color-gold)">Déconnexion</button>
        </div>
        <p id="list-meta" class="mt-4 text-sm text-(--color-paper)/50" role="status" aria-live="polite"></p>

        <div id="list-view" class="mt-4 overflow-x-auto">
          <table class="w-full min-w-[720px] text-left text-sm">
            <thead class="label-tracked text-(--color-paper)/50">
              <tr class="border-b border-(--color-line)">
                <th class="py-3 pr-4 font-semibold">Réf.</th>
                <th class="py-3 pr-4 font-semibold">Reçue</th>
                <th class="py-3 pr-4 font-semibold">Division</th>
                <th class="py-3 pr-4 font-semibold">Contact</th>
                <th class="py-3 pr-4 font-semibold">Origine</th>
                <th class="py-3 pr-4 font-semibold">Statut</th>
              </tr>
            </thead>
            <tbody id="inquiries-list" class="divide-y divide-(--color-line)"></tbody>
          </table>
          <p id="list-empty" hidden class="mt-10 text-(--color-paper)/60">Aucune demande pour ce filtre.</p>
        </div>

        <div id="detail-view" hidden class="mt-6">
          <button id="back-to-list" class="label-tracked text-(--color-paper)/60 hover:text-(--color-gold)">&larr; Retour à la liste</button>
          <div id="detail-content" class="mt-6"></div>
        </div>
      </div>
    </div>

    <script>
      import { initAdminInquiries } from "../../scripts/admin/inquiries";
      initAdminInquiries();
    </script>
  </body>
</html>
