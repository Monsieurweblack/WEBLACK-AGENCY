---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RemoteImage from "../../components/media/RemoteImage.astro";
import CardJournal from "../../components/cards/CardJournal.astro";
import CtaContact from "../../components/sections/CtaContact.astro";
import { useTranslations } from "../../i18n/utils";
import { getEntriesByLang, sortByDateDesc } from "../../lib/content";

const lang = "fr" as const;
const t = useTranslations(lang);
const articles = sortByDateDesc(await getEntriesByLang("journal", lang));
---

<BaseLayout lang={lang} title={t("journal.hero.title")} description={t("journal.seo.description")}>
  <section class="bg-(--color-ink) px-6 pb-16 pt-40 md:px-10">
    <div class="mx-auto max-w-(--container-content)" data-reveal>
      <p class="label-tracked label-tracked-dot text-(--color-gold)">{t("journal.hero.eyebrow")}</p>
      <h1 class="font-display mt-4 max-w-3xl text-4xl text-(--color-paper) sm:text-5xl">
        {t("journal.hero.title")}
      </h1>
    </div>
  </section>

  <div class="mx-auto aspect-[21/9] max-w-(--container-content) overflow-hidden bg-(--color-ink-soft) px-6 md:px-10">
    <RemoteImage
      src="/photos/banner-model-logo-bw-alt-2000.jpg"
      alt=""
      width={1942}
      height={809}
      loading="eager"
      fetchpriority="high"
      class="h-full w-full"
    />
  </div>

  <section class="bg-(--color-ink) px-6 py-24 md:px-10 md:py-32">
    <div class="mx-auto max-w-(--container-content)">
      {
        articles.length > 0 ? (
          <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3">
            {articles.map((article, i) => (
              <CardJournal lang={lang} article={article} index={i} />
            ))}
          </div>
        ) : (
          <p class="text-(--color-paper)/60">{t("journal.empty")}</p>
        )
      }
    </div>
  </section>

  <CtaContact lang={lang} />
</BaseLayout>

<script>
  import { initScrollChoreography } from "../../scripts/gsap/scroll-choreography";
  initScrollChoreography();
</script>
