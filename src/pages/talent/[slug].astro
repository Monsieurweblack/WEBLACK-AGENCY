---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TalentDetail from "../../components/pages/TalentDetail.astro";
import { useTranslations } from "../../i18n/utils";
import { getEntriesByLang } from "../../lib/content";

/**
 * Only status "active" talent get a real page — the 14 demo/seed entries
 * (status "archived") never generate one, same rule as the listing page.
 */
export async function getStaticPaths() {
  const talent = (await getEntriesByLang("talent", "fr")).filter((entry) => entry.data.status === "active");
  return talent.map((entry) => ({ params: { slug: entry.data.slug }, props: { talent: entry } }));
}

const { talent } = Astro.props;
const lang = "fr" as const;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={`${talent.data.name} — ${t("nav.talent")}`}
  description={`${talent.data.role} · ${talent.data.country}`}
  image={talent.data.portraitImage.url}
>
  <TalentDetail lang={lang} talent={talent} />
</BaseLayout>

<script>
  import { initScrollChoreography } from "../../scripts/gsap/scroll-choreography";
  initScrollChoreography();
</script>
