---
import BaseLayout from "../layouts/BaseLayout.astro";
import RemoteImage from "../components/media/RemoteImage.astro";
import CtaContact from "../components/sections/CtaContact.astro";
import { useTranslations, type UiKey } from "../i18n/utils";

const lang = "fr" as const;
const t = useTranslations(lang);

const pillars = ["people", "culture", "practice"] as const;
---

<BaseLayout lang={lang} title={t("responsibility.hero.title")} description={t("responsibility.hero.lead")}>
  <section class="bg-(--color-ink) px-6 pb-16 pt-40 md:px-10">
    <div class="mx-auto max-w-(--container-content)" data-reveal>
      <p class="label-tracked label-tracked-dot text-(--color-gold)">{t("responsibility.hero.eyebrow")}</p>
      <h1 class="font-display mt-4 max-w-3xl text-4xl text-(--color-paper) sm:text-5xl">
        {t("responsibility.hero.title")}
      </h1>
      <p class="mt-6 max-w-xl text-lg text-(--color-paper)/70">{t("responsibility.hero.lead")}</p>
    </div>
  </section>

  <div class="mx-auto aspect-[21/9] max-w-(--container-content) overflow-hidden bg-(--color-ink-soft) px-6 md:px-10">
    <RemoteImage
      src="/photos/banner-model-logo-bw-2400.jpg"
      alt=""
      width={2400}
      height={1000}
      loading="eager"
      fetchpriority="high"
      class="h-full w-full"
    />
  </div>

  <section class="bg-(--color-ink) py-24 md:py-32">
    <div class="mx-auto max-w-(--container-content) px-6 md:px-10">
      <div class="grid grid-cols-1 gap-16 border-t border-(--color-line) pt-16 md:grid-cols-3">
        {
          pillars.map((pillar, i) => (
            <div data-reveal data-reveal-delay={String(i * 0.1)}>
              <span class="label-tracked text-(--color-paper)/40">0{i + 1}</span>
              <h2 class="font-display mt-4 text-2xl text-(--color-paper)">
                {t(`responsibility.${pillar}.name` as UiKey)}
              </h2>
              <p class="mt-4 text-(--color-paper)/70">{t(`responsibility.${pillar}.desc` as UiKey)}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaContact lang={lang} />
</BaseLayout>

<script>
  import { initScrollChoreography } from "../scripts/gsap/scroll-choreography";
  initScrollChoreography();
</script>
