---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/forms/ContactForm.astro";
import { useTranslations, type UiKey } from "../i18n/utils";
import { CONTACT_EMAIL } from "../lib/contact";

const lang = "fr" as const;
const t = useTranslations(lang);

const segments = ["talent", "brand", "creative", "partner", "media", "other"] as const;
---

<BaseLayout lang={lang} title={t("nav.contact")} description={t("contact.hero.lead")}>
  <section class="bg-(--color-ink) px-6 pb-24 pt-40 md:px-10 md:pb-32">
    <div class="mx-auto grid max-w-(--container-content) grid-cols-1 gap-16 lg:grid-cols-[1fr_1.3fr]">
      <div data-reveal>
        <p class="label-tracked label-tracked-dot text-(--color-gold)">{t("contact.hero.eyebrow")}</p>
        <h1 class="font-display mt-4 text-4xl text-(--color-paper) sm:text-5xl">
          {t("contact.hero.title")}
        </h1>
        <p class="mt-6 max-w-md text-(--color-paper)/70">{t("contact.hero.lead")}</p>

        <div class="mt-12 space-y-6 border-t border-(--color-line) pt-8">
          <div>
            <p class="label-tracked text-(--color-gold)">{t("contact.info.email.label")}</p>
            <a
              href={`mailto:${CONTACT_EMAIL}`}
              class="mt-2 inline-block text-(--color-paper) transition-colors hover:text-(--color-gold)"
            >
              {CONTACT_EMAIL}
            </a>
          </div>
          <div>
            <p class="label-tracked text-(--color-gold)">WEBLACK</p>
            <p class="mt-2 text-(--color-paper)/70">{t("contact.info.address.label")}</p>
          </div>
        </div>
      </div>

      <div data-reveal data-reveal-delay="0.1">
        <div id="segment-picker" class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          {
            segments.map((segment) => (
              <button
                type="button"
                data-segment={segment}
                data-label={t(`contact.segment.${segment}` as UiKey)}
                class="label-tracked border border-(--color-line) px-6 py-8 text-left text-(--color-paper) transition-colors duration-300 hover:border-(--color-gold) hover:text-(--color-gold)"
              >
                {t(`contact.segment.${segment}` as UiKey)}
              </button>
            ))
          }
        </div>

        <div id="contact-form-wrap" class="hidden">
          <button
            id="contact-back"
            type="button"
            class="label-tracked text-(--color-paper)/60 transition-colors hover:text-(--color-gold)"
          >
            &larr; {t("contact.form.back")}
          </button>
          <p id="contact-form-profile-label" class="label-tracked mt-4 text-(--color-gold)"></p>
          <div class="mt-6">
            <ContactForm lang={lang} />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initScrollChoreography } from "../scripts/gsap/scroll-choreography";
  import { initContactSegments } from "../scripts/forms/contact-segments";
  initScrollChoreography();
  initContactSegments();
</script>
